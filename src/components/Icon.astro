  key: '<circle cx="8" cy="9" r="4"/><path d="M11.5 11.5 20 20M16 16l2.5-2.5M13.5 13.5 16 11"/>',
  whatsapp:
    '<path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.9 5-1.3A10 10 0 1 0 12 2z" fill="none"/><path d="M8.5 7.3c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5 0-.8.4-.3.4-1 1-1 2.4s1 2.8 1.2 3 2 3.2 5 4.4c2.5 1 3 .8 3.6.8.6-.1 1.8-.8 2-1.5.3-.7.3-1.3.2-1.5l-.7-.4-2-1c-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.6-2c-.2-.3 0-.4.1-.6l.5-.5.3-.5v-.5l-.9-2.1z"/>',
