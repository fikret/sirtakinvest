---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
import { social, whatsappLink } from '../config/site';
---
<BaseLayout
  title="Etkinlikler"
  description="Sirtakinvest Golden Visa bilgilendirme webinarları ve yüz yüze tanışma etkinlikleri."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Webinar & Buluşma</span>
      <h1>Etkinlikler</h1>
      <p class="lead">
        Golden Visa bilgilendirme webinarları ve yüz yüze tanışma etkinliklerimizi buradan takip
        edebilirsiniz.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="empty-state">
        <span class="es-icon"><Icon name="calendar" size={30} /></span>
        <h2>Yaklaşan etkinlik planlanıyor</h2>
        <p>
          Şu anda yayınlanmış bir etkinlik bulunmuyor. Yeni webinar ve buluşma tarihlerinden ilk siz
          haberdar olmak için bizi sosyal medyada takip edin veya doğrudan yazın.
        </p>
        <div class="es-actions">
          <a class="btn btn-gold" href={whatsappLink} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} />Haberdar Et
          </a>
          <a class="btn btn-outline" href={withBase('/toplanti-planla')}>
            <Icon name="calendar" size={18} />Bireysel Toplantı
          </a>
        </div>
        <div class="es-social">
          {
            social.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                <Icon name={s.icon} size={20} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) 1.5rem;
    background: linear-gradient(180deg, var(--paper-2), transparent);
  }
  .page-hero h1 {
    margin-top: 0.6rem;
  }
  .page-hero .lead {
    margin-top: 1rem;
    max-width: 58ch;
  }
  .empty-state {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(2.5rem, 2rem + 3vw, 4rem) 1.5rem;
    border: 1.5px dashed var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--white), var(--paper-2));
  }
  .es-icon {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    border-radius: 20px;
    color: var(--gold-600);
    background: var(--gold-100);
    border: 1px solid rgba(200, 162, 75, 0.4);
  }
  .empty-state h2 {
    color: var(--navy-800);
  }
  .empty-state p {
    max-width: 52ch;
    color: var(--muted);
    line-height: 1.65;
  }
  .es-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .es-social {
    display: flex;
    gap: 0.7rem;
    margin-top: 1rem;
    color: var(--navy-700);
  }
  .es-social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: all 0.2s var(--ease);
  }
  .es-social a:hover {
    background: var(--navy-800);
    color: var(--paper);
    border-color: var(--navy-800);
  }
</style>
