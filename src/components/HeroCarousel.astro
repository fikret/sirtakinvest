---
import Icon from './Icon.astro';
import PlaceholderImage from './PlaceholderImage.astro';

interface Slide {
  href: string;
  title: string;
  spot?: string;
  label?: string;
  tag?: string;
}
interface Props {
  slides: Slide[];
}
const { slides } = Astro.props;
---
<section class="hero" aria-roledescription="carousel" aria-label="Seçilen içerikler">
  <div class="hero-track" data-track>
    {
      slides.map((s, i) => (
        <article class="hero-slide" data-slide aria-label={`${i + 1} / ${slides.length}`}>
          <div class="hs-bg">
            <PlaceholderImage label={s.label ?? s.title} variant="auto" subtle />
          </div>
          <div class="container hs-content">
            <div class="hs-inner">
              {s.tag && <span class="eyebrow hs-eyebrow">{s.tag}</span>}
              <h2 class="hs-title">{s.title}</h2>
              {s.spot && <p class="hs-spot">{s.spot}</p>}
              <a class="btn btn-gold" href={s.href}>
                İncele
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <button class="hero-arrow hero-prev" data-prev aria-label="Önceki">
    <Icon name="arrow-left" size={24} />
  </button>
  <button class="hero-arrow hero-next" data-next aria-label="Sonraki">
    <Icon name="arrow-right" size={24} />
  </button>

  <div class="hero-dots" data-dots>
    {slides.map((_, i) => <button class="hero-dot" data-dot={i} aria-label={`${i + 1}. içerik`} />)}
  </div>
</section>

<style>
  .hero {
    position: relative;
  }
  .hero-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .hero-track::-webkit-scrollbar {
    display: none;
  }
  .hero-slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-height: clamp(420px, 60vh, 560px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hs-bg {
    position: absolute;
    inset: 0;
  }
  .hs-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(7, 26, 44, 0.86) 0%,
      rgba(7, 26, 44, 0.6) 42%,
      rgba(7, 26, 44, 0.2) 100%
    );
  }
  .hs-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .hs-inner {
    max-width: min(620px, 100%);
    min-width: 0;
    color: var(--paper);
  }
  .hs-eyebrow {
    color: var(--gold-400);
  }
  .hs-eyebrow::before {
    background: var(--gold-400);
  }
  .hs-title {
    margin-top: 1rem;
    font-size: clamp(1.85rem, 1.4rem + 2.6vw, 3.3rem);
    color: var(--paper);
    line-height: 1.08;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .hs-spot {
    margin-top: 1rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.55;
    color: rgba(247, 243, 234, 0.85);
    max-width: 52ch;
    overflow-wrap: break-word;
  }
  .hs-inner .btn {
    margin-top: 1.5rem;
  }

  .hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(247, 243, 234, 0.35);
    background: rgba(7, 26, 44, 0.35);
    backdrop-filter: blur(6px);
    color: var(--paper);
    transition: background 0.25s var(--ease), transform 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .hero-arrow:hover {
    background: var(--gold-500);
    border-color: var(--gold-500);
    color: #1c1304;
  }
  .hero-prev {
    left: clamp(0.6rem, 2vw, 1.6rem);
  }
  .hero-next {
    right: clamp(0.6rem, 2vw, 1.6rem);
  }
  .hero-dots {
    position: absolute;
    bottom: 1.1rem;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .hero-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: none;
    background: rgba(247, 243, 234, 0.4);
    transition: background 0.25s var(--ease), width 0.25s var(--ease);
  }
  .hero-dot[data-active] {
    background: var(--gold-400);
    width: 26px;
    border-radius: 6px;
  }

  @media (max-width: 680px) {
    /* Mobilde oklar metni örtmesin: dokunmatik kaydırma + noktalar yeterli */
    .hero-arrow {
      display: none;
    }
    .hero-dots {
      bottom: 0.9rem;
    }
  }
</style>

<script>
  const track = document.querySelector('[data-track]') as HTMLElement | null;
  if (track) {
    const slides = Array.from(track.querySelectorAll('[data-slide]'));
    const dots = Array.from(document.querySelectorAll('[data-dot]'));
    const prev = document.querySelector('[data-prev]');
    const next = document.querySelector('[data-next]');

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const idx = (i + slides.length) % slides.length;
      track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
    };
    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

    const setActive = () => {
      const c = current();
      dots.forEach((d, i) => (i === c ? d.setAttribute('data-active', '') : d.removeAttribute('data-active')));
    };
    setActive();
    track.addEventListener('scroll', () => window.requestAnimationFrame(setActive), { passive: true });

    // otomatik geçiş (kullanıcı etkileşimi yoksa)
    let timer = window.setInterval(() => go(current() + 1), 7000);
    const pause = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => go(current() + 1), 7000);
    };
    track.addEventListener('pointerdown', pause);
    [prev, next, ...dots].forEach((el) => el?.addEventListener('click', pause));
  }
</script>
