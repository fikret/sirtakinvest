---
import { site, nav, social } from '../config/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} ana sayfa`}>
      <span class="brand-name">{site.name}</span>
      <span class="brand-tagline">{site.tagline}</span>
    </a>

    <nav class="nav-desktop" aria-label="Ana menü">
      {
        nav.map((item) =>
          item.href === '/toplanti-planla' ? (
            <a class="nav-cta" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ) : (
            <a class="nav-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
      <span class="nav-sep" aria-hidden="true"></span>
      <div class="socials">
        {
          social.map((s) => (
            <a class="social" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
              <Icon name={s.icon} size={18} />
            </a>
          ))
        }
      </div>
    </nav>

    <button class="burger" data-burger aria-label="Menüyü aç" aria-expanded="false" aria-controls="mobile-menu">
      <Icon name="menu" size={24} />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile hidden>
    <nav aria-label="Mobil menü">
      {
        nav.map((item) => (
          <a class="mobile-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mobile-socials">
      {
        social.map((s) => (
          <a class="social" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
            <Icon name={s.icon} size={20} />
          </a>
        ))
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(247, 243, 234, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line-soft);
    transition: box-shadow 0.3s var(--ease), background 0.3s var(--ease);
  }
  .site-header[data-scrolled] {
    box-shadow: 0 6px 24px rgba(10, 34, 56, 0.08);
    background: rgba(247, 243, 234, 0.95);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 78px;
  }
  .brand {
    display: grid;
    line-height: 1.05;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.6rem);
    letter-spacing: 0.04em;
    color: var(--navy-800);
  }
  .brand-tagline {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.15em;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-link {
    position: relative;
    font-weight: 500;
    font-size: 0.96rem;
    color: var(--ink-soft);
    padding: 0.3em 0;
    transition: color 0.2s var(--ease);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1.5px;
    background: var(--gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--navy-800);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav-cta {
    font-weight: 600;
    font-size: 0.92rem;
    color: #1c1304;
    background: linear-gradient(135deg, var(--gold-400), var(--gold-600));
    padding: 0.6em 1.2em;
    border-radius: 999px;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .nav-sep {
    width: 1px;
    height: 22px;
    background: var(--line);
  }
  .socials {
    display: flex;
    gap: 0.35rem;
  }
  .social {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--navy-700);
    border: 1px solid var(--line-soft);
    transition: color 0.2s var(--ease), background 0.2s var(--ease), border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .social:hover {
    color: var(--white);
    background: var(--navy-800);
    border-color: var(--navy-800);
    transform: translateY(-2px);
  }

  .burger {
    display: none;
    background: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.4em;
    color: var(--navy-800);
  }

  .mobile-menu {
    display: none;
    border-top: 1px solid var(--line-soft);
    padding: 1rem clamp(1.1rem, 6vw, 2.4rem) 1.6rem;
    background: rgba(247, 243, 234, 0.98);
  }
  .mobile-menu nav {
    display: grid;
  }
  .mobile-link {
    padding: 0.85em 0.2em;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--navy-800);
    border-bottom: 1px solid var(--line-soft);
  }
  .mobile-link[aria-current='page'] {
    color: var(--gold-600);
  }
  .mobile-socials {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }

  @media (max-width: 900px) {
    .nav-desktop {
      display: none;
    }
    .burger {
      display: grid;
      place-items: center;
    }
    .mobile-menu[data-open] {
      display: block;
      animation: fade-up 0.3s var(--ease);
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const burger = document.querySelector('[data-burger]');
  const menu = document.querySelector('[data-mobile]');

  burger?.addEventListener('click', () => {
    const open = menu?.hasAttribute('data-open');
    if (open) {
      menu?.removeAttribute('data-open');
      menu?.setAttribute('hidden', '');
      burger?.setAttribute('aria-expanded', 'false');
    } else {
      menu?.setAttribute('data-open', '');
      menu?.removeAttribute('hidden');
      burger?.setAttribute('aria-expanded', 'true');
    }
  });

  const onScroll = () => {
    if (window.scrollY > 8) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
