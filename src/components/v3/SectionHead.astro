---
import PillBadge from './PillBadge.astro';
interface Props {
  badge: string;
  title: string;
  fade?: string; // iki-tonlu başlığın gri "devam" kısmı
  sub?: string;
  align?: 'left' | 'center';
}
const { badge, title, fade, sub, align = 'left' } = Astro.props;
---
<div class={`sh ${align === 'center' ? 'is-center' : ''}`}>
  <PillBadge text={badge} />
  <h2 class="sh-title t-heading-lg">
    {title}{fade && <span class="fade"> {fade}</span>}
  </h2>
  {sub && <p class="sh-sub t-body-lg text-slate">{sub}</p>}
</div>

<style>
  .sh {
    display: grid;
    gap: 16px;
    max-width: 720px;
    margin-bottom: var(--s-48);
  }
  .sh :global(.pill) {
    justify-self: start;
  }
  .sh.is-center {
    justify-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .sh.is-center :global(.pill) {
    justify-self: center;
  }
  .sh-title {
    color: var(--ink);
    margin: 0;
  }
  .sh-sub {
    margin: 0;
    max-width: 60ch;
  }
</style>
