---
import Icon from '../Icon.astro';
import PrimaryButton from './PrimaryButton.astro';
import { site } from '../../config/site';

const links = [
  { label: 'Hakkımızda', href: '#hakkimizda' },
  { label: 'Hizmetler', href: '#hizmetler' },
  { label: 'Sorular', href: '#sorular' },
  { label: 'Projeler', href: '#projeler' },
];
---
<header class="v3nav" data-v3nav>
  <div class="v3-container v3nav-inner">
    <a class="v3-word" href="#top">{site.name}</a>

    <nav class="v3nav-links" aria-label="Bölümler">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="v3nav-actions">
      <a class="v3nav-signin" href="#sorular">Sıkça sorulanlar</a>
      <PrimaryButton href="#iletisim" label="Toplantı Planla" class="v3nav-cta" />
      <button class="v3-burger" data-v3burger aria-label="Menü" aria-expanded="false" aria-controls="v3-menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="v3-mobile" id="v3-menu" data-v3menu hidden>
    <nav aria-label="Mobil bölümler">
      {links.map((l) => <a href={l.href} data-v3close>{l.label}</a>)}
      <a href="#iletisim" class="btn-primary v3mob-cta" data-v3close>Toplantı Planla <span aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>

<style>
  .v3nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }
  .v3nav[data-scrolled] {
    border-bottom-color: var(--mist);
  }
  .v3nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 68px;
  }
  .v3-word {
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  .v3nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-inline: auto;
  }
  .v3nav-links a {
    font-size: 0.875rem;
    color: var(--carbon);
    transition: color 0.2s var(--ease);
  }
  .v3nav-links a:hover {
    color: var(--indigo);
  }
  .v3nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .v3nav-signin {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .v3nav-signin:hover {
    color: var(--indigo);
  }
  .v3-burger {
    display: none;
    background: none;
    border: 1px solid var(--mist);
    border-radius: var(--radius);
    padding: 6px;
    color: var(--ink);
  }
  .v3-mobile {
    display: none;
    border-top: 1px solid var(--mist);
    padding: 12px clamp(20px, 5vw, 40px) 24px;
    background: var(--paper);
  }
  .v3-mobile nav {
    display: grid;
    gap: 2px;
  }
  .v3-mobile nav a {
    padding: 13px 4px;
    font-size: 1rem;
    color: var(--ink);
    border-bottom: 1px solid var(--mist);
  }
  .v3-mobile .v3mob-cta {
    margin-top: 14px;
    justify-content: center;
    border-bottom: 0;
  }

  @media (max-width: 940px) {
    .v3nav-links,
    .v3nav-signin,
    .v3nav-cta {
      display: none;
    }
    .v3-burger {
      display: grid;
      place-items: center;
    }
    .v3nav-actions {
      margin-left: auto;
    }
    .v3-mobile[data-open] {
      display: block;
      animation: v3-rise 0.3s var(--ease);
    }
  }
</style>

<script>
  const nav = document.querySelector('[data-v3nav]');
  const burger = document.querySelector('[data-v3burger]');
  const menu = document.querySelector('[data-v3menu]');
  const open = (o: boolean) => {
    if (o) { menu?.setAttribute('data-open', ''); menu?.removeAttribute('hidden'); }
    else { menu?.removeAttribute('data-open'); menu?.setAttribute('hidden', ''); }
    burger?.setAttribute('aria-expanded', String(o));
  };
  burger?.addEventListener('click', () => open(!menu?.hasAttribute('data-open')));
  document.querySelectorAll('[data-v3close]').forEach((a) => a.addEventListener('click', () => open(false)));
  const onScroll = () => {
    if (window.scrollY > 8) nav?.setAttribute('data-scrolled', '');
    else nav?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
