---
import V2Layout from '../../layouts/V2Layout.astro';
import PageHero from '../../components/v2/PageHero.astro';
import StoryCard from '../../components/v2/StoryCard.astro';
import CtaBanner from '../../components/v2/CtaBanner.astro';
import { getProjects, projectHref } from '../../lib/content';

const projects = await getProjects();
---
<V2Layout
  title="Projeler"
  description="Golden Visa'ya uygun, doğru fiyatlı yatırım projeleri: Atina, Glyfada, Nafplio, Selanik ve Pire."
>
  <PageHero
    badge="PORTFÖY"
    title="Projelerimiz"
    lead="Şişirilmiş fiyatlardan uzak; gerçek piyasa değerinde, kiralanabilir ve gerektiğinde satılabilir Golden Visa yatırım fırsatları."
  >
    <p class="note caption text-smoke">
      Aşağıdaki kayıtlar örnek (placeholder) projelerdir; gerçek görsel ve detaylar eklenecektir.
    </p>
  </PageHero>

  <section class="v2-section section-top">
    <div class="v2-container">
      <div class="proj-grid">
        {
          projects.map((p) => (
            <StoryCard
              href={projectHref(p.id)}
              name={p.data.title}
              desc={p.data.summary}
              meta={`${p.data.projectCode} · ${p.data.location} · ${p.data.priceFrom}`}
              label={p.data.placeholderLabel}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section">
    <div class="v2-container">
      <CtaBanner
        title="Size uygun projeyi birlikte bulalım."
        text="Bütçenize, yaşam tarzınıza ve yatırım hedefinize en uygun mülkü doğru fiyatla seçmek için tanışalım."
      />
    </div>
  </section>
</V2Layout>

<style>
  .note {
    margin-top: 16px;
  }
  .section-top {
    padding-top: 0;
  }
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 24px;
  }
  @media (max-width: 900px) {
    .proj-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
