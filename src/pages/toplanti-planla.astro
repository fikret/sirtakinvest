---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ZoomScheduler from '../components/ZoomScheduler.astro';

const topics = [
  'Yatırım amacınız: oturum mu, kira geliri mi, ikinci ev mi?',
  'Bütçenize ve aile yapınıza uygun mülk ve lokasyon seçenekleri',
  'Golden Visa sürecinin adımları ve yaklaşık takvim',
  'Aile kapsamı, mülkiyet yapısı ve hak güvenliği',
];
---
<BaseLayout
  title="Toplantı Planla"
  description="Yüz yüze veya online tanışma toplantısı için randevu alın. Golden Visa yolculuğunuzu birlikte planlayalım."
>
  <section class="plan-hero">
    <div class="container">
      <span class="eyebrow">Ücretsiz Tanışma</span>
      <h1>Toplantı Planlayın</h1>
      <p class="lead">
        Golden Visa yolculuğunuza başlamadan önce ihtiyaçlarınızı ve doğru yatırım stratejisini
        birlikte konuşalım. Aşağıdaki takvimden size uygun zamanı seçin.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container plan-grid">
      <div class="plan-main">
        <ZoomScheduler />
      </div>
      <aside class="plan-aside">
        <h2>Toplantıda neler konuşuruz?</h2>
        <ul class="topic-list">
          {topics.map((t) => <li><Icon name="check" size={18} />{t}</li>)}
        </ul>
        <div class="aside-note">
          <Icon name="clock" size={18} />
          <span>Görüşme ortalama 30–45 dakika sürer ve tamamen ücretsizdir.</span>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .plan-hero {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) 1.5rem;
    background: linear-gradient(180deg, var(--paper-2), transparent);
  }
  .plan-hero h1 {
    margin-top: 0.6rem;
  }
  .plan-hero .lead {
    margin-top: 1rem;
    max-width: 62ch;
  }
  .plan-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  .plan-aside {
    position: sticky;
    top: 100px;
    padding: 1.8rem;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line-soft);
    box-shadow: var(--shadow-sm);
  }
  .plan-aside h2 {
    font-size: 1.3rem;
    margin-bottom: 1.2rem;
  }
  .topic-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .topic-list li {
    display: flex;
    gap: 0.7em;
    align-items: flex-start;
    font-size: 0.96rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .topic-list :global(svg) {
    flex: none;
    margin-top: 0.15em;
    color: var(--gold-600);
  }
  .aside-note {
    display: flex;
    gap: 0.6em;
    align-items: flex-start;
    margin-top: 1.5rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .aside-note :global(svg) {
    flex: none;
    color: var(--navy-700);
    margin-top: 0.1em;
  }

  @media (max-width: 860px) {
    .plan-grid {
      grid-template-columns: 1fr;
    }
    .plan-aside {
      position: static;
    }
  }
</style>
