---
import Icon from '../Icon.astro';
import { withBase } from '../../lib/url';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Yüz yüze tanışma toplantısından randevu alın.',
  text = 'Golden Visa yolculuğunuza başlamadan önce ihtiyaçlarınızı ve doğru yatırım stratejisini birlikte konuşalım.',
} = Astro.props;
---
<div class="cta">
  <h2 class="cta-title heading">{title}</h2>
  <p class="cta-sub body text-smoke">{text}</p>
  <a class="btn-ember cta-ember" href={withBase('/toplanti-planla')}>
    <Icon name="calendar" size={18} /> Toplantı Planla
  </a>
</div>

<style>
  .cta {
    border: 1px solid var(--ink);
    border-radius: var(--r-card);
    padding: clamp(40px, 5vw, 80px);
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
  }
  .cta-title {
    max-width: 20ch;
  }
  .cta-sub {
    max-width: 52ch;
  }
  .cta-ember {
    margin-top: 16px;
  }
</style>
