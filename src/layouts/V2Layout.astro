---
/**
 * v2 layout — (dot)connect tasarımı için BAĞIMSIZ kabuk.
 * Kök sitenin BaseLayout/global.css'inden ayrıdır; Geist fontları + v2.css yükler.
 * İçerik koleksiyonları (articles/projects) ve site config ortak kullanılabilir.
 * Varsayılan noindex (yapım aşamasında / kök ile çift içerik SEO'su olmasın).
 */
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/v2.css';
import BaseHead from '../components/BaseHead.astro';
import V2Nav from '../components/v2/V2Nav.astro';
import V2Footer from '../components/v2/V2Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = 'v2', description, noindex = true } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <V2Nav />
    <main id="main">
      <slot />
    </main>
    <V2Footer />
  </body>
</html>
