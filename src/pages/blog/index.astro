---
import V2Layout from '../../layouts/V2Layout.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CategoryChips from '../../components/v2/CategoryChips.astro';
import QuestionCard from '../../components/v2/QuestionCard.astro';
import CtaBanner from '../../components/v2/CtaBanner.astro';
import { getArticles, articleHref } from '../../lib/content';

const articles = await getArticles();
---
<V2Layout
  title="Blog & Sık Sorulan Sorular"
  description="Yunanistan Golden Visa hakkında merak edilen tüm sorular: vize, yatırım, aile hakları, ikinci ev ve adalarda yazlık."
>
  <PageHero
    badge="BİLGİ MERKEZİ"
    title="Golden Visa rehberi"
    lead="Yunanistan Golden Visa sürecinin tüm sorularını; vize kolaylığından yatırım getirisine, aile haklarından ikinci ev hayaline kadar tek tek yanıtladık."
  />

  <section class="v2-section section-top">
    <div class="v2-container">
      <CategoryChips active="all" />
      <div class="q-grid">
        {
          articles.map((a, i) => (
            <QuestionCard
              href={articleHref(a.id)}
              num={String(i + 1).padStart(2, '0')}
              question={a.data.cardTitle}
              spot={a.data.spot}
              index={i}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section">
    <div class="v2-container">
      <CtaBanner />
    </div>
  </section>
</V2Layout>

<style>
  .section-top {
    padding-top: 0;
  }
  .q-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 900px) {
    .q-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .q-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
