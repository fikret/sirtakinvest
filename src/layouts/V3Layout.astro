---
/**
 * v3 layout — "Column" tasarımı için BAĞIMSIZ kabuk.
 * Kök site (global.css) ve v2'den (v2.css) ayrıdır; Inter + JetBrains Mono + v3.css yükler.
 * İçerik koleksiyonları (articles/projects) ve site config ortak kullanılabilir.
 * Varsayılan noindex (yapım aşamasında / kök ile çift içerik SEO'su olmasın).
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/v3.css';
import BaseHead from '../components/BaseHead.astro';
import V3Nav from '../components/v3/V3Nav.astro';
import V3Footer from '../components/v3/V3Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = 'v3', description, noindex = true } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <V3Nav />
    <main id="main">
      <slot />
    </main>
    <V3Footer />
  </body>
</html>
