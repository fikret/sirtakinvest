---
import Icon from './Icon.astro';
import { zoomSchedulerEmbed, whatsappLink, contact } from '../config/site';

const hasEmbed = zoomSchedulerEmbed.trim().length > 0;
---
{
  hasEmbed ? (
    <div class="zoom-embed" set:html={zoomSchedulerEmbed} />
  ) : (
    <div class="zoom-placeholder">
      <span class="zp-key" aria-hidden="true">
        <Icon name="calendar" size={28} />
      </span>
      <h3 class="subheading">Zoom randevu takvimi buraya gelecek</h3>
      <p class="caption text-smoke">
        Bu alan, Zoom Scheduler embed kodunuz için ayrılmıştır. Kodu eklemek için
        <code>src/config/site.ts</code> dosyasındaki <code>zoomSchedulerEmbed</code> alanına
        (backtick içine) yapıştırmanız yeterli — sayfa otomatik olarak canlı takvimi gösterecektir.
      </p>
      <div class="zp-actions">
        <a class="btn-ember" href={whatsappLink} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={18} />
          WhatsApp ile yaz
        </a>
        <a class="ghost-btn" href={contact.phoneHref}>
          <Icon name="phone" size={18} />
          {contact.phoneDisplay}
        </a>
      </div>
    </div>
  )
}

<style>
  .zoom-embed {
    width: 100%;
    min-height: 640px;
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--mist);
    background: var(--bone);
  }
  .zoom-embed :global(iframe) {
    width: 100%;
    min-height: 640px;
    border: 0;
    display: block;
  }

  .zoom-placeholder {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.9rem;
    padding: clamp(2.5rem, 2rem + 3vw, 4rem) 1.5rem;
    border: 1px dashed var(--mist);
    border-radius: var(--r-card);
    background: var(--ash);
  }
  .zp-key {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    color: var(--bone);
    background: var(--ink);
  }
  .zoom-placeholder h3 {
    color: var(--ink);
  }
  .zoom-placeholder p {
    max-width: 54ch;
    margin: 0;
  }
  .zoom-placeholder code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bone);
    border: 1px solid var(--mist);
    padding: 0.1em 0.4em;
    border-radius: 5px;
    color: var(--ink);
  }
  .zp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
    margin-top: 0.6rem;
  }
</style>
