---
import V2Layout from '../../layouts/V2Layout.astro';
import Breadcrumbs from '../../components/v2/Breadcrumbs.astro';
import CategoryChips from '../../components/v2/CategoryChips.astro';
import QuestionCard from '../../components/v2/QuestionCard.astro';
import CtaBanner from '../../components/v2/CtaBanner.astro';
import { getArticles, articleHref } from '../../lib/content';
import { withBase } from '../../lib/url';
import { categories } from '../../config/site';
import type { CategoryKey } from '../../config/site';

export async function getStaticPaths() {
  return Object.keys(categories).map((key) => ({ params: { category: key } }));
}

const { category } = Astro.params;
const key = category as CategoryKey;
const cat = categories[key];
const all = await getArticles();
const items = all.filter((a) => a.data.category === key);
---
<V2Layout title={cat.label} description={cat.description}>
  <section class="v2-section page-hero">
    <div class="v2-container">
      <Breadcrumbs
        items={[
          { label: 'Ana Sayfa', href: withBase('/') },
          { label: 'Blog', href: withBase('/blog') },
          { label: cat.label },
        ]}
      />
      <div class:list={['cat-hero', cat.image && 'cat-hero--media']}>
        <div class="cat-text">
          <span class="badge mono cat-badge">{cat.short}</span>
          <h1 class="heading-lg cat-title">{cat.label}</h1>
          <p class="cat-lead body text-smoke">{cat.description}</p>
        </div>
        {
          cat.image && (
            <div class="cat-media">
              <img
                src={withBase(cat.image)}
                alt={cat.imageAlt ?? cat.label}
                width="1600"
                height="1131"
                loading="eager"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="v2-section section-top">
    <div class="v2-container">
      <CategoryChips active={key} />
      {
        items.length > 0 ? (
          <div class="q-grid">
            {items.map((a, i) => (
              <QuestionCard
                href={articleHref(a.id)}
                num={String(i + 1).padStart(2, '0')}
                question={a.data.cardTitle}
                spot={a.data.spot}
                index={i}
              />
            ))}
          </div>
        ) : (
          <p class="empty body text-smoke">Bu kategoride henüz içerik bulunmuyor.</p>
        )
      }
    </div>
  </section>

  <section class="v2-section">
    <div class="v2-container">
      <CtaBanner />
    </div>
  </section>
</V2Layout>

<style>
  /* Görseli olan kategoride hero 2 sütun; olmayanlarda tek sütun (varsayılan). */
  .cat-hero--media {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  .cat-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--mist);
  }
  .cat-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .cat-badge {
    margin-top: 20px;
  }
  .cat-title {
    margin-top: 16px;
    max-width: 20ch;
  }
  .cat-lead {
    margin-top: 20px;
    max-width: 60ch;
  }
  .section-top {
    padding-top: 0;
  }
  .q-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  .empty {
    margin-top: 40px;
  }
  @media (max-width: 900px) {
    .cat-hero--media {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .cat-media {
      aspect-ratio: 16 / 9;
    }
    .q-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .q-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
