---
import { site, nav, social, contact, categories, whatsappLink } from '../config/site';
import { withBase } from '../lib/url';
import { categoryHref } from '../lib/content';
import Icon from './Icon.astro';

const year = 2026;
const catEntries = Object.entries(categories);
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="brand-name">{site.name}</span>
      <p class="footer-desc">{site.shortDescription}</p>
      <div class="footer-socials">
        {
          social.map((s) => (
            <a class="fsocial" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
              <Icon name={s.icon} size={18} />
            </a>
          ))
        }
      </div>
    </div>

    <nav class="footer-col" aria-label="Menü">
      <h3>Menü</h3>
      <ul>
        {nav.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Konular">
      <h3>Konular</h3>
      <ul>
        {catEntries.map(([key, c]) => <li><a href={categoryHref(key)}>{c.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <h3>İletişim</h3>
      <ul class="contact-list">
        <li>
          <a href={contact.phoneHref}><Icon name="phone" size={16} />{contact.phoneDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`}><Icon name="mail" size={16} />{contact.email}</a>
        </li>
        <li>
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={16} />WhatsApp</a>
        </li>
        <li class="addr"><Icon name="pin" size={16} />{contact.addressLine}</li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.name}. Tüm hakları saklıdır.</p>
    <p class="footer-note">Yunanistan · Golden Visa Yatırım Danışmanlığı</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background:
      radial-gradient(900px 400px at 88% 0%, rgba(29, 90, 134, 0.4), transparent 60%),
      linear-gradient(180deg, var(--navy-800), var(--navy-900));
    color: rgba(247, 243, 234, 0.78);
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 2.5rem 2rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    color: var(--paper);
  }
  .footer-desc {
    margin-top: 0.9rem;
    max-width: 38ch;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .footer-socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.3rem;
  }
  .fsocial {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--paper);
    border: 1px solid rgba(247, 243, 234, 0.2);
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .fsocial:hover {
    background: var(--gold-500);
    border-color: var(--gold-500);
    color: #1c1304;
    transform: translateY(-2px);
  }
  .footer-col h3 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin-bottom: 1.1rem;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .footer-col a {
    color: rgba(247, 243, 234, 0.78);
    font-size: 0.95rem;
    transition: color 0.2s var(--ease);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .footer-col a:hover {
    color: var(--gold-400);
  }
  .contact-list .addr {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.95rem;
  }
  .footer-bottom {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-block: 1.5rem;
    border-top: 1px solid rgba(247, 243, 234, 0.12);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: rgba(247, 243, 234, 0.6);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
