---
import V2Layout from '../layouts/V2Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/v2/PageHero.astro';
import ZoomScheduler from '../components/ZoomScheduler.astro';

const topics = [
  'Yatırım amacınız: oturum mu, kira geliri mi, ikinci ev mi?',
  'Bütçenize ve aile yapınıza uygun mülk ve lokasyon seçenekleri',
  'Golden Visa sürecinin adımları ve yaklaşık takvim',
  'Aile kapsamı, mülkiyet yapısı ve hak güvenliği',
];
---
<V2Layout
  title="Toplantı Planla"
  description="Yüz yüze veya online tanışma toplantısı için randevu alın. Golden Visa yolculuğunuzu birlikte planlayalım."
>
  <PageHero
    badge="ÜCRETSİZ TANIŞMA"
    title="Toplantı planlayın"
    lead="Golden Visa yolculuğunuza başlamadan önce ihtiyaçlarınızı ve doğru yatırım stratejisini birlikte konuşalım. Aşağıdaki takvimden size uygun zamanı seçin."
  />

  <section class="v2-section section-top">
    <div class="v2-container plan-grid">
      <div class="plan-main">
        <ZoomScheduler />
      </div>
      <aside class="plan-aside v2-card">
        <h2 class="subheading">Toplantıda neler konuşuruz?</h2>
        <ul class="topic-list">
          {topics.map((t) => <li class="caption"><Icon name="check" size={18} />{t}</li>)}
        </ul>
        <div class="aside-note caption text-smoke">
          <Icon name="clock" size={18} />
          <span>Görüşme ortalama 30–45 dakika sürer ve tamamen ücretsizdir.</span>
        </div>
      </aside>
    </div>
  </section>
</V2Layout>

<style>
  .section-top {
    padding-top: 0;
  }
  .plan-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .plan-aside {
    position: sticky;
    top: 100px;
    padding: 28px;
  }
  .plan-aside h2 {
    color: var(--ink);
    margin-bottom: 20px;
  }
  .topic-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .topic-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--smoke);
  }
  .topic-list :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--ember);
  }
  .aside-note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--mist);
  }
  .aside-note :global(svg) {
    flex: none;
    color: var(--ink);
    margin-top: 2px;
  }

  @media (max-width: 860px) {
    .plan-grid {
      grid-template-columns: 1fr;
    }
    .plan-aside {
      position: static;
    }
  }
</style>
