---
/**
 * İç sayfa başlık bloğu — badge (mono etiket) + büyük başlık + spot.
 * Ek içerik (aksiyon butonları, not) için default slot kullanılır.
 */
interface Props {
  badge?: string;
  title: string;
  lead?: string;
}
const { badge, title, lead } = Astro.props;
---
<section class="v2-section page-hero">
  <div class="v2-container">
    {badge && <span class="badge mono">{badge}</span>}
    <h1 class="heading-lg page-hero-title">{title}</h1>
    {lead && <p class="page-hero-lead body text-smoke">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-bottom: clamp(32px, 3vw, 48px);
  }
  .page-hero-title {
    margin-top: 20px;
    max-width: 20ch;
  }
  .page-hero-lead {
    margin-top: 20px;
    max-width: 60ch;
  }
</style>
