---
import V2Layout from '../../layouts/V2Layout.astro';
import { withBase } from '../../lib/url';
---
<V2Layout title="v2 — Yeni Tasarım (Yapım Aşamasında)">
  <main class="v2-placeholder">
    <div class="inner">
      <span class="badge">SIRTAKINVEST · v2</span>
      <h1>Yeni tasarım burada inşa edilecek</h1>
      <p>
        Bu sayfa <code>/v2/</code> için ayrılmış izole alandır. Mevcut canlı site bundan
        etkilenmez. Tasarım yönergenizi (prompt) verdiğinizde yeni tasarım bu adreste
        oluşturulacaktır.
      </p>
      <a class="back" href={withBase('/')}>← Mevcut siteye dön</a>
    </div>
  </main>
</V2Layout>
