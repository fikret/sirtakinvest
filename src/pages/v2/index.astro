---
import V2Layout from '../../layouts/V2Layout.astro';
import ArrowPill from '../../components/v2/ArrowPill.astro';
import SectionHeader from '../../components/v2/SectionHeader.astro';
import OfferCard from '../../components/v2/OfferCard.astro';
import QuestionCard from '../../components/v2/QuestionCard.astro';
import StoryCard from '../../components/v2/StoryCard.astro';
import Icon from '../../components/Icon.astro';
import { getArticles, getProjects, articleHref, projectHref, categoryHref } from '../../lib/content';
import { withBase } from '../../lib/url';
import { site, categories } from '../../config/site';
import type { CategoryKey } from '../../config/site';

const articles = await getArticles();
const projects = await getProjects();

const offerKeys: CategoryKey[] = ['vize-kolayligi', 'yatirim-firsati', 'aile-ve-haklar', 'adalarda-yazlik'];
const questions = articles.slice(0, 6);

const stats = [
  { v: '10+', l: 'yıl saha tecrübesi' },
  { v: '2–4 ay', l: 'ortalama süreç' },
  { v: '3 kuşak', l: 'aile kapsamı' },
  { v: 'Euro', l: 'bazlı kira getirisi' },
];
---
<V2Layout
  title="Golden Visa Yatırım Danışmanlığı"
  description="Yunanistan Golden Visa: doğru mülk, doğru fiyat, doğru hukuki yapı. 10 yılı aşkın saha tecrübesiyle Avrupa'da yasal oturum ve Euro bazlı yatırım."
>
  <!-- HERO -->
  <section class="hero v2-section">
    <div class="v2-container hero-inner">
      <span class="badge mono">YUNANİSTAN · GOLDEN VISA</span>
      <h1 class="display hero-title">Avrupa'da misafir değil, ev sahibi olun.</h1>
      <p class="hero-sub body text-smoke">
        Schengen çilesine son. Golden Visa size bir vize değil, Avrupa Birliği topraklarında
        kalıcı bir oturum hakkı ve Euro bazlı bir yatırım kazandırır — doğru mülk, doğru fiyat,
        doğru hukuki yapıyla.
      </p>
      <div class="hero-cta">
        <ArrowPill href="#iletisim" label="Tanışma toplantısı" />
        <a class="ghost-btn" href="#sorular">Sıkça sorulanlar</a>
      </div>
    </div>
  </section>

  <!-- HAKKIMIZDA + İSTATİSTİK -->
  <section id="hakkimizda" class="v2-section">
    <div class="v2-container">
      <SectionHeader num="00" label="Hakkımızda" />
      <div class="about-grid">
        <h2 class="about-statement heading-sm">
          {site.name}, Yunanistan Golden Visa sürecinde 10 yılı aşkın saha tecrübesiyle yanınızda.
          Bizim için oturum izni, kârlı bir gayrimenkul yatırımının yanındaki en güzel hediyedir.
        </h2>
        <div class="stats">
          {
            stats.map((s, i) => (
              <div class="stat reveal" style={`--d:${i * 70}ms`}>
                <span class="stat-v heading-sm">{s.v}</span>
                <span class="stat-l caption text-smoke">{s.l}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- HİZMETLER (OFFER) -->
  <section id="hizmetler" class="v2-section">
    <div class="v2-container">
      <SectionHeader num="01" label="Hizmetler" headline="Tek yatırım, dört yönde güvence." />
      <div class="offer-grid">
        {
          offerKeys.map((key, i) => (
            <OfferCard
              href={categoryHref(key)}
              title={categories[key].label}
              body={categories[key].description}
              index={i}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- SORULAR -->
  <section id="sorular" class="v2-section">
    <div class="v2-container">
      <SectionHeader num="02" label="Sorular" headline="Yatırımcıların en çok sorduğu sorular." />
      <div class="q-grid">
        {
          questions.map((a, i) => (
            <QuestionCard
              href={articleHref(a.id)}
              num={String(i + 1).padStart(2, '0')}
              question={a.data.cardTitle}
              spot={a.data.spot}
              index={i}
            />
          ))
        }
      </div>
      <div class="q-all">
        <a class="ghost-btn" href={withBase('/blog')}>Tüm sorular ({articles.length})</a>
      </div>
    </div>
  </section>

  <!-- PROJELER (CAROUSEL) -->
  <section id="projeler" class="v2-section">
    <div class="v2-container">
      <div class="proj-head">
        <SectionHeader num="03" label="Projeler" />
        <div class="proj-nav">
          <button class="caro-btn" data-prev aria-label="Önceki"><Icon name="arrow-left" size={18} /></button>
          <button class="caro-btn" data-next aria-label="Sonraki"><Icon name="arrow-right" size={18} /></button>
        </div>
      </div>
    </div>
    <div class="v2-container">
      <div class="proj-track" data-track>
        {
          projects.map((p) => (
            <div class="proj-item">
              <StoryCard
                href={projectHref(p.id)}
                name={p.data.title}
                desc={p.data.summary}
                meta={`${p.data.location} · ${p.data.priceFrom}`}
                label={p.data.placeholderLabel}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FELSEFE -->
  <section id="felsefe" class="v2-section">
    <div class="v2-container">
      <SectionHeader num="04" label="Felsefe" />
      <div class="philo">
        <h2 class="philo-line heading-lg">İyi bir yatırımın sırrı, alış fiyatında saklıdır.</h2>
        <p class="philo-body body text-smoke">
          Sadece vize limitini doldurmak için şişirilmiş fiyata alınan mülk, ileride hem düşük kira
          getirir hem de zor satılır. Biz mülkü gerçek piyasa değerinden aldırırız; böylece kira
          geliriniz piyasa seviyesinde oluşur ve gerektiğinde değerinde satarsınız. Oturum izni,
          doğru kurgulanmış bir yatırımın doğal sonucudur.
        </p>
      </div>
    </div>
  </section>

  <!-- İLETİŞİM / CTA -->
  <section id="iletisim" class="v2-section">
    <div class="v2-container">
      <div class="cta">
        <h2 class="cta-title heading">Yüz yüze tanışma toplantısından randevu alın.</h2>
        <p class="cta-sub body text-smoke">
          Golden Visa yolculuğunuza başlamadan önce ihtiyaçlarınızı ve doğru yatırım stratejisini
          birlikte konuşalım.
        </p>
        <a class="btn-ember cta-ember" href={withBase('/toplanti-planla')}>
          <Icon name="calendar" size={18} /> Toplantı Planla
        </a>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  /* HERO */
  .hero {
    padding-top: clamp(48px, 6vw, 96px);
  }
  .hero-inner {
    display: grid;
    justify-items: start;
    gap: 24px;
    max-width: 960px;
  }
  .hero-title {
    max-width: 16ch;
  }
  .hero-sub {
    max-width: 56ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
  }

  /* HAKKIMIZDA */
  .about-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .about-statement {
    max-width: 28ch;
    color: var(--ink);
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--mist);
    border: 1px solid var(--mist);
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .stat {
    background: var(--bone);
    padding: 24px;
    display: grid;
    gap: 6px;
  }
  .stat-v {
    color: var(--ink);
  }
  .stat-l {
    text-transform: lowercase;
  }

  /* OFFER */
  .offer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  /* SORULAR */
  .q-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .q-all {
    margin-top: 40px;
  }

  /* PROJELER */
  .proj-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .proj-head :global(.sec-head) {
    flex: 1;
    margin-bottom: 32px;
  }
  .proj-nav {
    display: flex;
    gap: 8px;
    padding-top: 4px;
  }
  .caro-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bone);
    border: 1px solid var(--mist);
    color: var(--ink);
    display: grid;
    place-items: center;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .caro-btn:hover {
    background: var(--ash);
    border-color: var(--ink);
  }
  .proj-track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 8px;
  }
  .proj-track::-webkit-scrollbar {
    display: none;
  }
  .proj-item {
    flex: 0 0 clamp(260px, 32%, 360px);
    scroll-snap-align: start;
  }

  /* FELSEFE */
  .philo {
    background: var(--ash);
    border: 1px solid var(--mist);
    border-radius: var(--r-card);
    padding: clamp(32px, 4vw, 64px);
    display: grid;
    gap: 28px;
  }
  .philo-line {
    max-width: 18ch;
    color: var(--ink);
  }
  .philo-body {
    max-width: 64ch;
  }

  /* CTA */
  .cta {
    border: 1px solid var(--ink);
    border-radius: var(--r-card);
    padding: clamp(40px, 5vw, 80px);
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
  }
  .cta-title {
    max-width: 20ch;
  }
  .cta-sub {
    max-width: 52ch;
  }
  .cta-ember {
    margin-top: 16px;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .q-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .offer-grid,
    .q-grid,
    .stats {
      grid-template-columns: 1fr;
    }
    .proj-item {
      flex-basis: 82%;
    }
  }
</style>

<script>
  const track = document.querySelector('[data-track]') as HTMLElement | null;
  if (track) {
    const step = () => Math.min(track.clientWidth * 0.85, 384);
    document.querySelector('[data-prev]')?.addEventListener('click', () =>
      track.scrollBy({ left: -step(), behavior: 'smooth' }),
    );
    document.querySelector('[data-next]')?.addEventListener('click', () =>
      track.scrollBy({ left: step(), behavior: 'smooth' }),
    );
  }
</script>
