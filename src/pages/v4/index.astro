---
import V4Layout from '../../layouts/V4Layout.astro';
import { withBase } from '../../lib/url';
---
<V4Layout title="v4 — Yeni Tasarım (Yapım Aşamasında)">
  <main class="v4-placeholder">
    <div class="inner">
      <span class="badge">SIRTAKINVEST · v4</span>
      <h1>Yeni tasarım burada inşa edilecek</h1>
      <p>
        Bu sayfa <code>/v4/</code> için ayrılmış izole alandır. Mevcut canlı site,
        <code>/v2/</code> ve <code>/v3/</code> bundan etkilenmez. Tasarım yönergenizi (prompt)
        verdiğinizde yeni tasarım bu adreste oluşturulacaktır.
      </p>
      <a class="back" href={withBase('/')}>← Mevcut siteye dön</a>
    </div>
  </main>
</V4Layout>
