---
/**
 * Sitenin ana layout'u — (dot)connect (v2) tasarım sistemi.
 * Geist fontları + v2.css yükler; V2Nav (çok sayfalı) + V2Footer kabuğu.
 * İçerik koleksiyonları (articles/projects) ve site config ortak kullanılır.
 */
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/v2.css';
import BaseHead from '../components/BaseHead.astro';
import V2Nav from '../components/v2/V2Nav.astro';
import V2Footer from '../components/v2/V2Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, image, type, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} noindex={noindex} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <V2Nav />
    <main id="main">
      <slot />
    </main>
    <V2Footer />
  </body>
</html>
