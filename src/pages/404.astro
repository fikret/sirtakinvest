---
import V2Layout from '../layouts/V2Layout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
---
<V2Layout title="Sayfa Bulunamadı" noindex={true}>
  <section class="v2-section nf">
    <div class="v2-container">
      <span class="nf-code display">404</span>
      <hr class="hairline nf-rule" />
      <h1 class="heading nf-title">Aradığınız sayfa bulunamadı</h1>
      <p class="nf-lead body text-smoke">Bağlantı taşınmış ya da hiç var olmamış olabilir. Buradan devam edebilirsiniz:</p>
      <div class="nf-actions">
        <a class="btn-ember" href={withBase('/')}><Icon name="arrow-left" size={16} />Ana Sayfa</a>
        <a class="ghost-btn" href={withBase('/blog')}>Tüm Sorular</a>
        <a class="ghost-btn" href={withBase('/toplanti-planla')}>Toplantı Planla</a>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  .nf {
    text-align: center;
    padding-block: clamp(64px, 6vw, 128px);
  }
  .nf-code {
    color: var(--ink);
    line-height: 1;
  }
  .nf-rule {
    max-width: 200px;
    margin: 32px auto;
  }
  .nf-title {
    margin-top: 8px;
  }
  .nf-lead {
    margin-top: 16px;
    max-width: 48ch;
    margin-inline: auto;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 32px;
  }
</style>
