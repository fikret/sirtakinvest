---
interface Props { href: string; label: string; external?: boolean; class?: string }
const { href, label, external = false, class: className = '' } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---
<a class={`btn-primary ${className}`} href={href} target={target} rel={rel}>
  <span>{label}</span>
  <span class="arr" aria-hidden="true">→</span>
</a>
