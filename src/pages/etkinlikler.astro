---
import V2Layout from '../layouts/V2Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/v2/PageHero.astro';
import { withBase } from '../lib/url';
import { social, whatsappLink } from '../config/site';
---
<V2Layout
  title="Etkinlikler"
  description="Sirtakinvest Golden Visa bilgilendirme webinarları ve yüz yüze tanışma etkinlikleri."
>
  <PageHero
    badge="WEBINAR & BULUŞMA"
    title="Etkinlikler"
    lead="Golden Visa bilgilendirme webinarları ve yüz yüze tanışma etkinliklerimizi buradan takip edebilirsiniz."
  />

  <section class="v2-section section-top">
    <div class="v2-container">
      <div class="empty-state">
        <span class="es-icon"><Icon name="calendar" size={30} /></span>
        <h2 class="heading-sm">Yaklaşan etkinlik planlanıyor</h2>
        <p class="es-text body text-smoke">
          Şu anda yayınlanmış bir etkinlik bulunmuyor. Yeni webinar ve buluşma tarihlerinden ilk siz
          haberdar olmak için bizi sosyal medyada takip edin veya doğrudan yazın.
        </p>
        <div class="es-actions">
          <a class="btn-ember" href={whatsappLink} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} />Haberdar Et
          </a>
          <a class="ghost-btn" href={withBase('/toplanti-planla')}>
            <Icon name="calendar" size={18} />Bireysel Toplantı
          </a>
        </div>
        <div class="es-social">
          {
            social.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                <Icon name={s.icon} size={20} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  .section-top {
    padding-top: 0;
  }
  .empty-state {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(2.5rem, 2rem + 3vw, 4rem) 1.5rem;
    border: 1px dashed var(--mist);
    border-radius: var(--r-card);
    background: var(--ash);
  }
  .es-icon {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    border-radius: 20px;
    color: var(--bone);
    background: var(--ink);
  }
  .empty-state h2 {
    color: var(--ink);
  }
  .es-text {
    max-width: 52ch;
  }
  .es-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .es-social {
    display: flex;
    gap: 0.7rem;
    margin-top: 1rem;
  }
  .es-social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--mist);
    color: var(--ink);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .es-social a:hover {
    background: var(--ash);
    border-color: var(--ink);
  }
</style>
