---
import V2Layout from '../../layouts/V2Layout.astro';
import Breadcrumbs from '../../components/v2/Breadcrumbs.astro';
import CategoryChips from '../../components/v2/CategoryChips.astro';
import QuestionCard from '../../components/v2/QuestionCard.astro';
import CtaBanner from '../../components/v2/CtaBanner.astro';
import { getArticles, articleHref } from '../../lib/content';
import { withBase } from '../../lib/url';
import { categories } from '../../config/site';
import type { CategoryKey } from '../../config/site';

export async function getStaticPaths() {
  return Object.keys(categories).map((key) => ({ params: { category: key } }));
}

const { category } = Astro.params;
const key = category as CategoryKey;
const cat = categories[key];
const all = await getArticles();
const items = all.filter((a) => a.data.category === key);
---
<V2Layout title={cat.label} description={cat.description}>
  <section class="v2-section page-hero">
    <div class="v2-container">
      <Breadcrumbs
        items={[
          { label: 'Ana Sayfa', href: withBase('/') },
          { label: 'Blog', href: withBase('/blog') },
          { label: cat.label },
        ]}
      />
      <span class="badge mono cat-badge">{cat.short}</span>
      <h1 class="heading-lg cat-title">{cat.label}</h1>
      <p class="cat-lead body text-smoke">{cat.description}</p>
    </div>
  </section>

  <section class="v2-section section-top">
    <div class="v2-container">
      <CategoryChips active={key} />
      {
        items.length > 0 ? (
          <div class="q-grid">
            {items.map((a, i) => (
              <QuestionCard
                href={articleHref(a.id)}
                num={String(i + 1).padStart(2, '0')}
                question={a.data.cardTitle}
                spot={a.data.spot}
                index={i}
              />
            ))}
          </div>
        ) : (
          <p class="empty body text-smoke">Bu kategoride henüz içerik bulunmuyor.</p>
        )
      }
    </div>
  </section>

  <section class="v2-section">
    <div class="v2-container">
      <CtaBanner />
    </div>
  </section>
</V2Layout>

<style>
  .cat-badge {
    margin-top: 20px;
  }
  .cat-title {
    margin-top: 16px;
    max-width: 20ch;
  }
  .cat-lead {
    margin-top: 20px;
    max-width: 60ch;
  }
  .section-top {
    padding-top: 0;
  }
  .q-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  .empty {
    margin-top: 40px;
  }
  @media (max-width: 900px) {
    .q-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .q-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
