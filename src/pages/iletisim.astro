---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { contact, social, whatsappLink, site } from '../config/site';

const channels = [
  { icon: 'phone', label: 'Telefon', value: contact.phoneDisplay, href: contact.phoneHref },
  { icon: 'whatsapp', label: 'WhatsApp', value: 'Sohbet başlat', href: whatsappLink, external: true },
  { icon: 'mail', label: 'E-posta', value: contact.email, href: `mailto:${contact.email}` },
  { icon: 'pin', label: 'Adres', value: contact.addressLine },
];
---
<BaseLayout
  title="İletişim"
  description="Sirtakinvest ile iletişime geçin. Golden Visa sorularınız için telefon, WhatsApp veya e-posta ile ulaşın."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Bize Ulaşın</span>
      <h1>İletişim</h1>
      <p class="lead">
        Golden Visa süreciyle ilgili sorularınız için bize dilediğiniz kanaldan ulaşabilir ya da
        doğrudan bir tanışma toplantısı planlayabilirsiniz.
      </p>
      <p class="note">
        Not: Aşağıdaki iletişim bilgileri şimdilik örnek (placeholder) değerlerdir;
        <code>src/config/site.ts</code> dosyasından güncelleyebilirsiniz.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container contact-grid">
      <div class="channels">
        {
          channels.map((c) =>
            c.href ? (
              <a
                class="channel reveal"
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
              >
                <span class="ch-icon"><Icon name={c.icon} size={22} /></span>
                <span class="ch-text">
                  <span class="ch-label">{c.label}</span>
                  <span class="ch-value">{c.value}</span>
                </span>
                <Icon name="arrow-up-right" size={18} class="ch-arrow" />
              </a>
            ) : (
              <div class="channel reveal">
                <span class="ch-icon"><Icon name={c.icon} size={22} /></span>
                <span class="ch-text">
                  <span class="ch-label">{c.label}</span>
                  <span class="ch-value">{c.value}</span>
                </span>
              </div>
            ),
          )
        }
      </div>

      <aside class="contact-cta">
        <h2>Hemen Tanışalım</h2>
        <p>En hızlı yol: takvimimizden size uygun bir zaman seçin, yüz yüze veya online görüşelim.</p>
        <a class="btn btn-gold" href="/toplanti-planla"><Icon name="calendar" size={18} />Toplantı Planla</a>
        <div class="cta-social">
          <span>Takip edin</span>
          <div class="cs-icons">
            {
              social.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                  <Icon name={s.icon} size={18} />
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) 1.5rem;
    background: linear-gradient(180deg, var(--paper-2), transparent);
  }
  .page-hero h1 {
    margin-top: 0.6rem;
  }
  .page-hero .lead {
    margin-top: 1rem;
    max-width: 58ch;
  }
  .note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .note code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
    background: rgba(13, 43, 69, 0.07);
    padding: 0.1em 0.4em;
    border-radius: 5px;
    color: var(--navy-800);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  .channels {
    display: grid;
    gap: 1rem;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line-soft);
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  a.channel:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: rgba(200, 162, 75, 0.5);
  }
  .ch-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: var(--gold-600);
    background: var(--gold-100);
    border: 1px solid rgba(200, 162, 75, 0.35);
  }
  .ch-text {
    flex: 1;
    display: grid;
    gap: 0.15rem;
  }
  .ch-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ch-value {
    font-weight: 600;
    color: var(--navy-800);
  }
  .ch-arrow {
    color: var(--navy-600);
  }

  .contact-cta {
    padding: 1.9rem;
    border-radius: var(--radius);
    color: var(--paper);
    background:
      radial-gradient(90% 80% at 90% 0%, rgba(29, 90, 134, 0.55), transparent 60%),
      linear-gradient(160deg, var(--navy-700), var(--navy-900));
    box-shadow: var(--shadow-md);
  }
  .contact-cta h2 {
    color: var(--paper);
  }
  .contact-cta p {
    margin-top: 0.7rem;
    margin-bottom: 1.4rem;
    color: rgba(247, 243, 234, 0.82);
    line-height: 1.6;
  }
  .cta-social {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(247, 243, 234, 0.16);
    font-size: 0.85rem;
    color: rgba(247, 243, 234, 0.7);
  }
  .cs-icons {
    display: flex;
    gap: 0.5rem;
  }
  .cs-icons a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--paper);
    border: 1px solid rgba(247, 243, 234, 0.22);
    transition: all 0.2s var(--ease);
  }
  .cs-icons a:hover {
    background: var(--gold-500);
    border-color: var(--gold-500);
    color: #1c1304;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
