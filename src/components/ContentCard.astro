---
import Icon from './Icon.astro';
import { categories } from '../config/site';
import type { CategoryKey } from '../config/site';

interface Props {
  href: string;
  cardTitle: string;
  spot?: string;
  category?: CategoryKey;
  label?: string;
  style?: string;
}
const { href, cardTitle, spot, category, label, style } = Astro.props;
const catLabel = category ? categories[category].short : label;
---
<a class="card content-card reveal" href={href} style={style}>
  <div class="cc-body">
    {catLabel && <span class="cc-tag">{catLabel}</span>}
    <h3 class="cc-title">{cardTitle}</h3>
    {spot && <p class="cc-spot">{spot}</p>}
  </div>
  <span class="cc-more">
    Devamını oku
    <Icon name="arrow-right" size={16} />
  </span>
</a>

<style>
  .content-card {
    padding: 1.5rem 1.5rem 1.35rem;
    min-height: 100%;
    justify-content: space-between;
    gap: 1.1rem;
  }
  .content-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, var(--gold-400), var(--gold-600));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s var(--ease);
  }
  .content-card:hover::before {
    transform: scaleY(1);
  }
  .cc-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-600);
    margin-bottom: 0.8rem;
  }
  .cc-title {
    font-size: clamp(1.12rem, 1rem + 0.5vw, 1.32rem);
    line-height: 1.18;
    color: var(--navy-800);
    text-wrap: balance;
  }
  .cc-spot {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--navy-700);
  }
  .cc-more :global(svg) {
    transition: transform 0.3s var(--ease);
  }
  .content-card:hover .cc-more :global(svg) {
    transform: translateX(4px);
  }
</style>
