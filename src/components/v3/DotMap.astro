---
/**
 * Halftone dünya haritası — Column sisteminin imza görseli.
 * Kıta elipslerinden land-mask üretir; her noktayı 125° 6-stop gradyanla tint'ler.
 * Build-time hesaplanır → statik SVG (JS gerekmez). Kenarlardan taşar (slice).
 */
interface Props {
  cols?: number;
  rows?: number;
  water?: boolean;
  class?: string;
}
const { cols = 72, rows = 34, water = true, class: className = '' } = Astro.props;

// Kıta elipsleri (normalize lon/lat: x=0..1 batı→doğu, y=0..1 kuzey→güney)
const CONT: [number, number, number, number][] = [
  // Kuzey Amerika
  [0.2, 0.28, 0.1, 0.12], [0.15, 0.2, 0.06, 0.06], [0.255, 0.4, 0.035, 0.05],
  // Grönland
  [0.34, 0.13, 0.035, 0.045],
  // Güney Amerika
  [0.31, 0.6, 0.055, 0.14], [0.275, 0.5, 0.045, 0.05],
  // Avrupa
  [0.52, 0.235, 0.045, 0.05], [0.49, 0.275, 0.03, 0.03],
  // Afrika
  [0.535, 0.5, 0.075, 0.135],
  // Asya
  [0.7, 0.27, 0.13, 0.11], [0.625, 0.34, 0.04, 0.04], [0.685, 0.4, 0.045, 0.05], [0.78, 0.4, 0.05, 0.05],
  // Endonezya / Japonya
  [0.79, 0.52, 0.05, 0.022], [0.845, 0.3, 0.016, 0.032],
  // Avustralya
  [0.84, 0.64, 0.06, 0.05],
];
const isLand = (x: number, y: number) =>
  CONT.some(([cx, cy, rx, ry]) => ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2 <= 1);

// 125° 6-stop gradyan örnekleyici
const STOPS: [number, [number, number, number]][] = [
  [0.0, [214, 86, 32]],
  [0.14, [159, 122, 238]],
  [0.32, [69, 117, 205]],
  [0.5, [113, 210, 240]],
  [0.68, [68, 180, 139]],
  [0.85, [244, 223, 105]],
];
const hex = (n: number) => n.toString(16).padStart(2, '0');
function sample(t: number): string {
  t = Math.max(0, Math.min(1, t));
  let a = STOPS[0], b = STOPS[STOPS.length - 1];
  for (let i = 0; i < STOPS.length - 1; i++) {
    if (t >= STOPS[i][0] && t <= STOPS[i + 1][0]) { a = STOPS[i]; b = STOPS[i + 1]; break; }
  }
  const span = b[0] - a[0] || 1;
  const k = (t - a[0]) / span;
  const c = a[1].map((v, i) => Math.round(v + (b[1][i] - v) * k));
  return `#${hex(c[0])}${hex(c[1])}${hex(c[2])}`;
}
// 125° yönü: dir=(sin125, cos125)≈(0.819, 0.574); normalize 0..1
const tAt = (x: number, y: number) => (x * 0.819 + y * 0.574) / 1.393;

const U = 6; // hücre birimi
const W = cols * U;
const H = rows * U;
const land: { x: number; y: number; c: string }[] = [];
const sea: { x: number; y: number }[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const nx = (c + 0.5) / cols;
    const ny = (r + 0.5) / rows;
    if (isLand(nx, ny)) {
      land.push({ x: c * U + U / 2, y: r * U + U / 2, c: sample(tAt(nx, ny)) });
    } else if (water && (c + r) % 2 === 0) {
      sea.push({ x: c * U + U / 2, y: r * U + U / 2 });
    }
  }
}
---
<div class={`dotmap ${className}`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    {sea.map((d) => <circle cx={d.x} cy={d.y} r="0.9" fill="#7c7f88" opacity="0.16" />)}
    {land.map((d) => <circle cx={d.x} cy={d.y} r="1.9" fill={d.c} opacity="0.9" />)}
  </svg>
</div>

<style>
  .dotmap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .dotmap svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
