---
import { getCollection, render } from 'astro:content';
import V2Layout from '../../layouts/V2Layout.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/v2/Breadcrumbs.astro';
import V2Placeholder from '../../components/v2/V2Placeholder.astro';
import CtaBanner from '../../components/v2/CtaBanner.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<V2Layout title={d.title} description={d.summary} type="article">
  <article>
    <header class="v2-section proj-hero">
      <div class="v2-container">
        <Breadcrumbs
          items={[
            { label: 'Ana Sayfa', href: withBase('/') },
            { label: 'Projeler', href: withBase('/projeler') },
            { label: d.title },
          ]}
        />
        <div class="ph-grid">
          <div class="ph-text">
            <span class="badge mono">{d.projectCode}</span>
            <h1 class="heading ph-title">{d.title}</h1>
            <p class="proj-loc caption"><Icon name="pin" size={16} />{d.location}</p>
            <p class="ph-lead body text-smoke">{d.summary}</p>
            <div class="proj-meta">
              <div class="meta-box">
                <span class="meta-label caption">Başlangıç Fiyatı</span>
                <span class="meta-value heading-sm">{d.priceFrom}</span>
              </div>
              <div class="meta-box">
                <span class="meta-label caption">Durum</span>
                <span class="meta-value heading-sm">{d.status}</span>
              </div>
            </div>
            <a class="btn-ember proj-cta" href={withBase('/toplanti-planla')}>
              <Icon name="calendar" size={18} />
              Bu Proje İçin Randevu Al
            </a>
          </div>
          <div class="ph-media">
            <V2Placeholder label={d.placeholderLabel || d.location} ember />
          </div>
        </div>
      </div>
    </header>

    <div class="v2-container proj-body">
      <div class="prose">
        <Content />
      </div>
      <div class="proj-back">
        <a class="ghost-btn" href={withBase('/projeler')}>
          <Icon name="arrow-left" size={16} />
          Tüm Projeler
        </a>
      </div>
    </div>

    <div class="v2-container proj-cta-wrap">
      <CtaBanner />
    </div>
  </article>
</V2Layout>

<style>
  .proj-hero {
    border-bottom: 1px solid var(--mist);
  }
  .ph-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: 28px;
  }
  .ph-title {
    margin-top: 16px;
  }
  .proj-loc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    color: var(--ember);
    font-weight: 500;
  }
  .ph-lead {
    margin-top: 16px;
    max-width: 52ch;
  }
  .proj-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
  }
  .meta-box {
    display: grid;
    gap: 4px;
    padding: 16px 22px;
    border-radius: var(--r-card);
    background: var(--bone);
    border: 1px solid var(--mist);
  }
  .meta-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    color: var(--smoke);
  }
  .meta-value {
    color: var(--ink);
  }
  .proj-cta {
    margin-top: 28px;
  }
  .ph-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--mist);
  }
  .proj-body {
    padding-block: clamp(40px, 5vw, 72px);
  }
  .proj-back {
    max-width: 68ch;
    margin: 40px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--mist);
  }
  .proj-cta-wrap {
    padding-bottom: var(--section-gap);
  }
  @media (max-width: 900px) {
    .ph-grid {
      grid-template-columns: 1fr;
    }
    .ph-media {
      order: -1;
      aspect-ratio: 16 / 9;
    }
  }
</style>
