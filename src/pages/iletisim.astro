---
import V2Layout from '../layouts/V2Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/v2/PageHero.astro';
import { withBase } from '../lib/url';
import { contact, social, whatsappLink } from '../config/site';

const channels = [
  { icon: 'phone', label: 'Telefon', value: contact.phoneDisplay, href: contact.phoneHref },
  { icon: 'whatsapp', label: 'WhatsApp', value: 'Sohbet başlat', href: whatsappLink, external: true },
  { icon: 'mail', label: 'E-posta', value: contact.email, href: `mailto:${contact.email}` },
  { icon: 'pin', label: 'Adres', value: contact.addressLine },
];
---
<V2Layout
  title="İletişim"
  description="Sirtakinvest ile iletişime geçin. Golden Visa sorularınız için telefon, WhatsApp veya e-posta ile ulaşın."
>
  <PageHero
    badge="BİZE ULAŞIN"
    title="İletişim"
    lead="Golden Visa süreciyle ilgili sorularınız için bize dilediğiniz kanaldan ulaşabilir ya da doğrudan bir tanışma toplantısı planlayabilirsiniz."
  >
    <p class="note caption text-smoke">
      Not: Aşağıdaki iletişim bilgileri şimdilik örnek (placeholder) değerlerdir;
      <code>src/config/site.ts</code> dosyasından güncelleyebilirsiniz.
    </p>
  </PageHero>

  <section class="v2-section section-top">
    <div class="v2-container contact-grid">
      <div class="channels">
        {
          channels.map((c, i) =>
            c.href ? (
              <a
                class="channel v2-card reveal"
                style={`--d:${i * 60}ms`}
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
              >
                <span class="ch-icon"><Icon name={c.icon} size={22} /></span>
                <span class="ch-text">
                  <span class="ch-label caption text-smoke">{c.label}</span>
                  <span class="ch-value">{c.value}</span>
                </span>
                <Icon name="arrow-up-right" size={18} class="ch-arrow" />
              </a>
            ) : (
              <div class="channel v2-card reveal" style={`--d:${i * 60}ms`}>
                <span class="ch-icon"><Icon name={c.icon} size={22} /></span>
                <span class="ch-text">
                  <span class="ch-label caption text-smoke">{c.label}</span>
                  <span class="ch-value">{c.value}</span>
                </span>
              </div>
            ),
          )
        }
      </div>

      <aside class="contact-cta">
        <h2 class="heading-sm">Hemen tanışalım.</h2>
        <p class="caption">En hızlı yol: takvimimizden size uygun bir zaman seçin, yüz yüze veya online görüşelim.</p>
        <a class="btn-ember" href={withBase('/toplanti-planla')}><Icon name="calendar" size={18} />Toplantı Planla</a>
        <div class="cta-social">
          <span class="caption">Takip edin</span>
          <div class="cs-icons">
            {
              social.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                  <Icon name={s.icon} size={18} />
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>
</V2Layout>

<style>
  .note {
    margin-top: 16px;
  }
  .note code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--ash);
    border: 1px solid var(--mist);
    padding: 0.1em 0.4em;
    border-radius: 5px;
    color: var(--ink);
  }
  .section-top {
    padding-top: 0;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 24px;
    align-items: start;
  }
  .channels {
    display: grid;
    gap: 16px;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
  }
  .ch-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: var(--bone);
    background: var(--ink);
  }
  .ch-text {
    flex: 1;
    display: grid;
    gap: 2px;
  }
  .ch-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
  }
  .ch-value {
    font-weight: 500;
    color: var(--ink);
  }
  .ch-arrow {
    color: var(--smoke);
  }

  .contact-cta {
    padding: 32px;
    border-radius: var(--r-card);
    color: var(--bone);
    background: var(--ink);
  }
  .contact-cta h2 {
    color: var(--bone);
  }
  .contact-cta p {
    margin-top: 12px;
    margin-bottom: 24px;
    color: color-mix(in srgb, var(--bone) 78%, transparent);
    line-height: 1.5;
  }
  .cta-social {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--bone) 18%, transparent);
    color: color-mix(in srgb, var(--bone) 70%, transparent);
  }
  .cs-icons {
    display: flex;
    gap: 8px;
  }
  .cs-icons a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--bone);
    border: 1px solid color-mix(in srgb, var(--bone) 24%, transparent);
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .cs-icons a:hover {
    background: var(--ember);
    border-color: var(--ember);
    color: var(--bone);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
