---
import Icon from '../Icon.astro';
interface Props {
  href?: string;
  icon: string;
  title: string;
  desc: string;
  index?: number;
}
const { href, icon, title, desc, index = 0 } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="feat reveal" href={href} style={`--d:${index * 70}ms`}>
  <span class="feat-ic"><Icon name={icon} size={18} /></span>
  <h3 class="feat-title">{title}</h3>
  <p class="feat-desc t-body-sm text-slate">{desc}</p>
</Tag>

<style>
  .feat {
    display: block;
    padding: var(--s-24);
    border-radius: var(--radius);
    border: 1px solid var(--mist);
    background: var(--card);
    transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease);
  }
  a.feat:hover {
    box-shadow: var(--sh-card);
    transform: translateY(-2px);
  }
  .feat-ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--mist);
    color: var(--indigo);
    margin-bottom: 16px;
  }
  .feat-title {
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .feat-desc {
    margin: 0;
  }
</style>
