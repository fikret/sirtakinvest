---
import V2Layout from '../layouts/V2Layout.astro';
import ArrowPill from '../components/v2/ArrowPill.astro';
import SectionHeader from '../components/v2/SectionHeader.astro';
import OfferCard from '../components/v2/OfferCard.astro';
import QuestionCard from '../components/v2/QuestionCard.astro';
import StoryCard from '../components/v2/StoryCard.astro';
import SocialCard from '../components/v2/SocialCard.astro';
import ZoomScheduler from '../components/ZoomScheduler.astro';
import Icon from '../components/Icon.astro';
import { getArticles, getProjects, articleHref, projectHref, categoryHref } from '../lib/content';
import { withBase } from '../lib/url';
import { site, categories, instagramPosts, youtubeVideos } from '../config/site';
import type { CategoryKey } from '../config/site';

const articles = await getArticles();
const projects = await getProjects();

const offerKeys: CategoryKey[] = ['vize-kolayligi', 'yatirim-firsati', 'adalarda-yazlik'];
const questions = articles.slice(0, 9);

const stats = [
  { v: '10+', l: 'yıl saha tecrübesi' },
  { v: '2–4 ay', l: 'ortalama süreç' },
  { v: '3 kuşak', l: 'aile kapsamı' },
  { v: 'Euro', l: 'bazlı kira getirisi' },
];
---
<V2Layout
  title="Golden Visa Yatırım Danışmanlığı"
  description="Yunanistan Golden Visa: doğru mülk, doğru fiyat, doğru hukuki yapı. 10 yılı aşkın saha tecrübesiyle Avrupa'da yasal oturum ve Euro bazlı yatırım."
>
  <!-- HERO -->
  <section class="hero v2-section">
    <div class="v2-container hero-inner">
      <span class="badge mono">YUNANİSTAN · GOLDEN VISA</span>
      <h1 class="display hero-title">Avrupa'da misafir değil, ev sahibi olun.</h1>
      <p class="hero-sub body text-smoke">
        Schengen çilesine son. Golden Visa size bir vize değil, Avrupa Birliği topraklarında
        kalıcı bir oturum hakkı ve Euro bazlı bir yatırım kazandırır — doğru mülk, doğru fiyat,
        doğru hukuki yapıyla.
      </p>
      <div class="hero-cta">
        <ArrowPill href={withBase('/toplanti-planla')} label="Tanışma Toplantısı Planla" />
        <a class="ghost-btn" href="#sorular">Sıkça Sorulan Sorular</a>
      </div>
    </div>
  </section>

  <!-- HİZMETLER (OFFER) -->
  <section id="hizmetler" class="v2-section">
    <div class="v2-container">
      <SectionHeader num="01" label="Hizmetler" headline="Tek yatırım, üç yönde güvence." />
      <div class="offer-grid">
        {
          offerKeys.map((key, i) => (
            <OfferCard
              href={categoryHref(key)}
              title={categories[key].label}
              body={categories[key].description}
              index={i}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- SORULAR -->
  <section id="sorular" class="v2-section">
    <div class="v2-container">
      <SectionHeader num="02" label="Sorular" headline="Yatırımcıların en çok sorduğu sorular." />
      <div class="q-grid">
        {
          questions.map((a, i) => (
            <QuestionCard
              href={articleHref(a.id)}
              num={String(i + 1).padStart(2, '0')}
              question={a.data.cardTitle}
              spot={a.data.spot}
              index={i}
            />
          ))
        }
      </div>
      <div class="q-all">
        <a class="ghost-btn" href={withBase('/blog')}>Tüm sorular ({articles.length})</a>
      </div>
    </div>
  </section>

  <!-- HAKKIMIZDA (genişleyebilir) + SOSYAL İÇERİK -->
  <section id="hakkimizda" class="v2-section">
    <div class="v2-container">
      <SectionHeader num="03" label="Hakkımızda" />
      <div class="about-grid">
        <div class="about-text">
          <h2 class="about-statement heading-sm">
            {site.name}, Yunanistan Golden Visa sürecinde 10 yılı aşkın saha tecrübesiyle yanınızda.
            Bizim için oturum izni, kârlı bir gayrimenkul yatırımının yanındaki en güzel hediyedir.
          </h2>
          <details class="about-expand">
            <summary>
              <span class="ax-label">Devamını oku</span>
              <span class="ax-chev"><Icon name="arrow-down" size={15} /></span>
            </summary>
            <div class="about-long body text-smoke">
              <p>
                Yunanistan, kriz günlerini çoktan geride bıraktı; bugün Avrupa'nın en diri yatırım
                merkezlerinden biri. Ancak bir yatırımcı olarak asıl mesele sadece oturum izni almak
                değil, paranızın karşılığını gerçekten almaktır. Doğru bir stratejiyle yapılan yatırım
                size sadece bir “kart” kazandırmaz; yarın satmak istediğinizde yerel halkın bile talip
                olacağı, gerçek değeri olan bir mülk kazandırır.
              </p>
              <p>
                Golden Visa'yı tek bir kişinin aldığı oturum kartı olarak değil; eşinizi,
                çocuklarınızı, anne-babanızı ve eşinizin anne-babasını kapsayan bir aile koruma
                kalkanı olarak görüyoruz. Her ailenin yapısı farklıdır; bu yüzden yatırımı, olası
                senaryoları da düşünerek baştan doğru kurgularız.
              </p>
            </div>
          </details>
          <a class="ghost-btn about-link" href={withBase('/hakkinda')}>
            Hakkımızda sayfası <Icon name="arrow-right" size={15} />
          </a>
        </div>
        <div class="stats">
          {
            stats.map((s, i) => (
              <div class="stat reveal" style={`--d:${i * 70}ms`}>
                <span class="stat-v heading-sm">{s.v}</span>
                <span class="stat-l caption text-smoke">{s.l}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="social-rows">
        <div class="social-row">
          <h3 class="social-h mono">INSTAGRAM</h3>
          <div class="social-grid">
            {
              instagramPosts.map((p) => (
                <SocialCard href={p.href} title={p.title} image={p.image} kind="instagram" />
              ))
            }
          </div>
        </div>
        <div class="social-row">
          <h3 class="social-h mono">YOUTUBE</h3>
          <div class="social-grid">
            {
              youtubeVideos.map((v) => (
                <SocialCard href={v.href} title={v.title} label={v.label} kind="youtube" />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJELER (CAROUSEL) -->
  <section id="projeler" class="v2-section">
    <div class="v2-container">
      <div class="proj-head">
        <SectionHeader num="04" label="Projeler" />
        <div class="proj-nav">
          <button class="caro-btn" data-prev aria-label="Önceki"><Icon name="arrow-left" size={18} /></button>
          <button class="caro-btn" data-next aria-label="Sonraki"><Icon name="arrow-right" size={18} /></button>
        </div>
      </div>
    </div>
    <div class="v2-container">
      <div class="proj-track" data-track>
        {
          projects.map((p) => (
            <div class="proj-item">
              <StoryCard
                href={projectHref(p.id)}
                name={p.data.title}
                desc={p.data.summary}
                meta={`${p.data.location} · ${p.data.priceFrom}`}
                label={p.data.placeholderLabel}
              />
            </div>
          ))
        }
      </div>
      <div class="q-all">
        <a class="ghost-btn" href={withBase('/projeler')}>Tüm projeler ({projects.length})</a>
      </div>
    </div>
  </section>

  <!-- İLETİŞİM / TOPLANTI PLANLA -->
  <section id="iletisim" class="v2-section">
    <div class="v2-container">
      <SectionHeader
        num="05"
        label="İletişim"
        headline="Yüz yüze tanışma toplantısından randevu alın."
      />
      <p class="cta-intro body text-smoke">
        Golden Visa yolculuğunuza başlamadan önce ihtiyaçlarınızı ve doğru yatırım stratejisini
        birlikte konuşalım. Aşağıdaki takvimden size uygun zamanı seçin.
      </p>
      <div class="home-scheduler">
        <ZoomScheduler />
      </div>
    </div>
  </section>
</V2Layout>

<style>
  /* HERO */
  .hero {
    padding-top: clamp(48px, 6vw, 96px);
  }
  .hero-inner {
    display: grid;
    justify-items: start;
    gap: 24px;
    max-width: 960px;
  }
  .hero-title {
    max-width: 16ch;
  }
  .hero-sub {
    max-width: 56ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
  }

  /* OFFER (3 sütun) */
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* SORULAR (3 satır) */
  .q-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .q-all {
    margin-top: 40px;
  }

  /* HAKKIMIZDA */
  .about-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .about-text {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .about-statement {
    max-width: 28ch;
    color: var(--ink);
  }
  .about-expand {
    width: 100%;
  }
  .about-expand summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    cursor: pointer;
    list-style: none;
    color: var(--signal);
    font-weight: 500;
    font-size: 1rem;
    padding: 11px 24px;
    border: 1px solid var(--signal);
    border-radius: var(--r-button);
    transition: background 0.25s var(--ease);
  }
  .about-expand summary::-webkit-details-marker {
    display: none;
  }
  .about-expand summary:hover {
    background: rgba(0, 122, 255, 0.06);
  }
  .ax-chev {
    display: inline-grid;
    place-items: center;
    transition: transform 0.25s var(--ease);
  }
  .about-expand[open] .ax-chev {
    transform: rotate(180deg);
  }
  .about-long {
    margin-top: 20px;
    display: grid;
    gap: 1em;
    max-width: 64ch;
  }
  .about-link {
    width: fit-content;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--mist);
    border: 1px solid var(--mist);
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .stat {
    background: var(--bone);
    padding: 24px;
    display: grid;
    gap: 6px;
  }
  .stat-v {
    color: var(--ink);
  }
  .stat-l {
    text-transform: lowercase;
  }

  /* SOSYAL İÇERİK SATIRLARI */
  .social-rows {
    margin-top: 64px;
    display: grid;
    gap: 48px;
  }
  .social-h {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--mist);
    margin-bottom: 20px;
  }
  .social-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* PROJELER */
  .proj-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .proj-head :global(.sec-head) {
    flex: 1;
    margin-bottom: 32px;
  }
  .proj-nav {
    display: flex;
    gap: 8px;
    padding-top: 4px;
  }
  .caro-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bone);
    border: 1px solid var(--mist);
    color: var(--ink);
    display: grid;
    place-items: center;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .caro-btn:hover {
    background: var(--ash);
    border-color: var(--ink);
  }
  .proj-track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 8px;
  }
  .proj-track::-webkit-scrollbar {
    display: none;
  }
  .proj-item {
    flex: 0 0 clamp(260px, 32%, 360px);
    scroll-snap-align: start;
  }

  /* İLETİŞİM / SCHEDULER */
  .cta-intro {
    max-width: 60ch;
    margin-bottom: 40px;
  }
  .home-scheduler {
    width: 100%;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .offer-grid,
    .q-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .offer-grid,
    .q-grid,
    .stats,
    .social-grid {
      grid-template-columns: 1fr;
    }
    .proj-item {
      flex-basis: 82%;
    }
  }
</style>

<script>
  const track = document.querySelector('[data-track]') as HTMLElement | null;
  if (track) {
    const step = () => Math.min(track.clientWidth * 0.85, 384);
    document.querySelector('[data-prev]')?.addEventListener('click', () =>
      track.scrollBy({ left: -step(), behavior: 'smooth' }),
    );
    document.querySelector('[data-next]')?.addEventListener('click', () =>
      track.scrollBy({ left: step(), behavior: 'smooth' }),
    );
  }
</script>
