---
/**
 * v3 layout — yeni tasarım için BAĞIMSIZ kabuk.
 * Kök sitenin BaseLayout/global.css'inden ve v2'den ayrıdır; yalnızca v3.css yükler.
 * İçerik koleksiyonları (articles/projects) ve site config ortak kullanılabilir.
 * Varsayılan olarak noindex (yapım aşamasında arama motorlarına kapalı).
 */
import '../styles/v3.css';
import BaseHead from '../components/BaseHead.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = 'v3', description, noindex = true } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <slot />
  </body>
</html>
