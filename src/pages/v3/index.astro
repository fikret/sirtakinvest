---
import V3Layout from '../../layouts/V3Layout.astro';
import DotMap from '../../components/v3/DotMap.astro';
import PillBadge from '../../components/v3/PillBadge.astro';
import PrimaryButton from '../../components/v3/PrimaryButton.astro';
import GhostButton from '../../components/v3/GhostButton.astro';
import DataCard from '../../components/v3/DataCard.astro';
import CaseStudyCard from '../../components/v3/CaseStudyCard.astro';
import FeatureItem from '../../components/v3/FeatureItem.astro';
import QuestionCard from '../../components/v3/QuestionCard.astro';
import SectionHead from '../../components/v3/SectionHead.astro';
import { getArticles, getProjects, articleHref, projectHref, categoryHref } from '../../lib/content';
import { withBase } from '../../lib/url';
import { categories } from '../../config/site';
import type { CategoryKey } from '../../config/site';

const articles = await getArticles();
const projects = await getProjects();
const questions = articles.slice(0, 6);

const featIcon: Record<CategoryKey, string> = {
  'vize-kolayligi': 'key',
  'yatirim-firsati': 'trending-up',
  'aile-ve-haklar': 'users',
  'ikinci-ev': 'home',
  'adalarda-yazlik': 'globe',
};
const featKeys = Object.keys(categories) as CategoryKey[];

const featured = projects[0];
const rest = projects.slice(1, 4);

const stats = [
  { v: '10+', l: 'yıl saha tecrübesi' },
  { v: '2–4 ay', l: 'ortalama süreç' },
  { v: '3 kuşak', l: 'aile kapsamı' },
  { v: '5 yıl', l: 'yenilenebilir oturum' },
];
---
<V3Layout
  title="Golden Visa Yatırım Danışmanlığı"
  description="Yunanistan Golden Visa: Avrupa'da kalıcı oturum ve Euro bazlı gayrimenkul yatırımı. 10 yılı aşkın saha tecrübesiyle doğru mülk, doğru fiyat, doğru hukuki yapı."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"><DotMap cols={80} rows={34} /></div>
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="v3-container hero-grid">
      <div class="hero-left">
        <PillBadge text="Yunanistan · Golden Visa" />
        <h1 class="t-display hero-title">Avrupa'da kalıcı oturum, <span class="fade">Euro bazlı yatırım.</span></h1>
        <p class="t-body-lg text-slate hero-sub">
          Golden Visa size bir vize değil; Avrupa Birliği topraklarında kalıcı oturum hakkı ve doğru
          fiyatlı, Euro bazlı bir gayrimenkul yatırımı kazandırır.
        </p>
        <div class="hero-cta">
          <PrimaryButton href="#iletisim" label="Toplantı Planla" />
          <GhostButton href="#sorular" label="Sıkça sorulanlar" />
        </div>
        <p class="hero-trust mono">10+ YIL TECRÜBE · 3 KUŞAK AİLE · 2–4 AY SÜREÇ</p>
      </div>

      <div class="hero-right">
        <div class="hero-code" aria-hidden="true">
          <span class="hc-bar"><i></i><i></i><i></i> ledger.json</span>
          <pre class="hc-pre">{`{
  "oturum": "5 yıl",
  "yenileme": "süresiz",
  "aile": ["eş","çocuk","ebeveyn"],
  "kira": "EUR · uzun dönem"
}`}</pre>
        </div>
        <DataCard
          flag="🇬🇷"
          label="Yunanistan · Golden Visa"
          status="AKTİF"
          value="€250.000"
          sub="MİN. GAYRİMENKUL YATIRIMI · 5 YIL OTURUM"
          float
          class="hero-front"
        >
          <div class="hero-front-rows">
            <span><b>Schengen</b> vizesiz seyahat</span>
            <span><b>Aile</b> eş · çocuk · ebeveyn</span>
          </div>
        </DataCard>
      </div>
    </div>
  </section>

  <!-- GÜVEN BANDI -->
  <section id="hakkimizda" class="v3-section">
    <div class="v3-container">
      <SectionHead
        badge="Güvenilir Danışmanlık"
        title="10 yılı aşkın saha tecrübesiyle"
        fade="Avrupa'da güvenli oturum ve doğru yatırım."
      />
      <div class="stats-strip v3-card-bordered">
        {
          stats.map((s, i) => (
            <div class="stat">
              <span class="stat-v t-heading-sm">{s.v}</span>
              <span class="stat-l t-body-sm text-slate">{s.l}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HİZMETLER -->
  <section id="hizmetler" class="v3-section">
    <div class="v3-container">
      <SectionHead
        badge="Hizmetler"
        title="Tek yatırım,"
        fade="çok yönde güvence."
        sub="Oturum izni, doğru kurgulanmış bir gayrimenkul yatırımının doğal sonucudur."
      />
      <div class="feat-grid">
        {
          featKeys.map((key, i) => (
            <FeatureItem
              href={categoryHref(key)}
              icon={featIcon[key]}
              title={categories[key].label}
              desc={categories[key].description}
              index={i}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- SORULAR -->
  <section id="sorular" class="v3-section">
    <div class="v3-container">
      <SectionHead
        badge="Sık Sorulanlar"
        title="Yatırımcıların"
        fade="en çok sorduğu sorular."
      />
      <div class="q-grid">
        {
          questions.map((a, i) => (
            <QuestionCard
              href={articleHref(a.id)}
              num={`(${String(i + 1).padStart(2, '0')})`}
              question={a.data.cardTitle}
              spot={a.data.spot}
              index={i}
            />
          ))
        }
      </div>
      <div class="q-all">
        <GhostButton href={withBase('/blog')} label={`Tüm sorular (${articles.length})`} />
      </div>
    </div>
  </section>

  <!-- PROJELER -->
  <section id="projeler" class="v3-section">
    <div class="v3-container">
      <div class="proj-split">
        <div class="proj-text">
          <SectionHead
            badge="Portföy"
            title="Doğru fiyatlı,"
            fade="kiralanabilir ve satılabilir mülkler."
            sub="Şişirilmiş fiyatlardan uzak; gerçek piyasa değerinde, Euro bazlı kira getiren Golden Visa projeleri."
          />
          <GhostButton href={withBase('/projeler')} label="Tüm projeler" />
        </div>
        {
          featured && (
            <CaseStudyCard
              href={projectHref(featured.id)}
              brand={featured.data.title}
              location={featured.data.location}
              value={featured.data.priceFrom}
              class="proj-feature"
            />
          )
        }
      </div>
      <div class="proj-grid">
        {
          rest.map((p) => (
            <a class="proj-dc" href={projectHref(p.id)}>
              <DataCard flag="🇬🇷" label={p.data.projectCode} status={p.data.status} value={p.data.priceFrom} sub={p.data.location.toUpperCase()}>
                <span class="proj-dc-name t-body-sm text-slate">{p.data.title}</span>
              </DataCard>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FELSEFE / QUOTE -->
  <section id="felsefe" class="v3-section">
    <div class="v3-container">
      <figure class="quote">
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote class="quote-line t-heading-lg">
          İyi bir yatırımın sırrı, alış fiyatında saklıdır. Doğru fiyattan alınan mülk hem daha iyi
          kira getirir hem de gerektiğinde değerinde satılır.
        </blockquote>
        <figcaption class="quote-by t-body-sm text-slate">Sirtakinvest · Golden Visa yatırım danışmanlığı</figcaption>
      </figure>
    </div>
  </section>

  <!-- İLETİŞİM CTA -->
  <section id="iletisim" class="v3-section">
    <div class="v3-container">
      <div class="cta v3-card float">
        <div class="cta-map"><DotMap cols={72} rows={20} water={false} /></div>
        <div class="cta-inner">
          <PillBadge text="Tanışma Toplantısı" />
          <h2 class="t-heading cta-title">Yüz yüze tanışma toplantısından randevu alın.</h2>
          <p class="t-body text-slate cta-sub">
            Golden Visa yolculuğunuza başlamadan önce ihtiyaçlarınızı ve doğru yatırım stratejisini
            birlikte konuşalım.
          </p>
          <PrimaryButton href={withBase('/toplanti-planla')} label="Toplantı Planla" />
        </div>
      </div>
    </div>
  </section>
</V3Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 5vw, 80px) clamp(48px, 6vw, 96px);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(100deg, transparent 0%, #000 45%, #000 100%);
    mask-image: linear-gradient(100deg, transparent 0%, #000 45%, #000 100%);
  }
  .hero-bloom {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60%;
    height: 90%;
    background: var(--grad-bloom);
    filter: blur(60px);
    opacity: 0.18;
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .hero-title {
    margin-top: 20px;
    max-width: 14ch;
  }
  .hero-sub {
    margin-top: 20px;
    max-width: 48ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero-trust {
    margin-top: 28px;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--fog);
  }

  .hero-right {
    position: relative;
    min-height: 320px;
    display: grid;
    place-items: center;
  }
  .hero-front {
    position: relative;
    z-index: 2;
    width: min(380px, 100%);
    margin-left: -10%;
  }
  .hero-front-rows {
    display: grid;
    gap: 6px;
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--slate);
  }
  .hero-front-rows b {
    color: var(--ink);
    font-weight: 500;
  }
  .hero-code {
    position: absolute;
    z-index: 1;
    top: 4%;
    right: 0;
    width: min(300px, 80%);
    background: var(--graphite);
    border-radius: var(--radius);
    box-shadow: var(--sh-float);
    overflow: hidden;
  }
  .hc-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--fog);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hc-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }
  .hc-pre {
    margin: 0;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--cyan);
    white-space: pre;
    overflow-x: auto;
  }

  /* GÜVEN BANDI */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 0;
    overflow: hidden;
  }
  .stat {
    padding: 28px 24px;
    display: grid;
    gap: 4px;
    border-right: 1px solid var(--mist);
  }
  .stat:last-child {
    border-right: 0;
  }
  .stat-v {
    color: var(--ink);
    font-weight: 400;
  }

  /* HİZMETLER */
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* SORULAR */
  .q-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .q-all {
    margin-top: 32px;
  }

  /* PROJELER */
  .proj-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
    margin-bottom: 32px;
  }
  .proj-text :global(.sh) {
    margin-bottom: 24px;
  }
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .proj-dc {
    display: block;
    transition: transform 0.25s var(--ease);
  }
  .proj-dc:hover {
    transform: translateY(-3px);
  }
  .proj-dc-name {
    display: block;
  }

  /* FELSEFE */
  .quote {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 20px;
  }
  .quote-mark {
    font-weight: 300;
    font-size: 4rem;
    line-height: 0.6;
    color: var(--fog);
  }
  .quote-line {
    color: var(--ink);
    margin: 0;
    max-width: 24ch;
  }
  .quote-by {
    margin: 0;
  }

  /* CTA */
  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 5vw, 72px);
  }
  .cta-map {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    -webkit-mask-image: radial-gradient(80% 120% at 80% 50%, #000, transparent 75%);
    mask-image: radial-gradient(80% 120% at 80% 50%, #000, transparent 75%);
  }
  .cta-inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 14px;
    max-width: 560px;
    margin-inline: auto;
  }
  .cta-title {
    color: var(--ink);
    max-width: 20ch;
  }
  .cta-sub {
    max-width: 48ch;
  }

  /* RESPONSIVE */
  @media (max-width: 940px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-right {
      order: -1;
      min-height: 280px;
    }
    .hero-front {
      margin-left: 0;
    }
    .proj-split {
      grid-template-columns: 1fr;
    }
    .feat-grid,
    .q-grid,
    .proj-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .stats-strip {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(2) {
      border-right: 0;
    }
    .stat:nth-child(-n + 2) {
      border-bottom: 1px solid var(--mist);
    }
    .feat-grid,
    .q-grid,
    .proj-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
