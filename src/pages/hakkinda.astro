---
import V2Layout from '../layouts/V2Layout.astro';
import Icon from '../components/Icon.astro';
import ArrowPill from '../components/v2/ArrowPill.astro';
import V2Placeholder from '../components/v2/V2Placeholder.astro';
import CtaBanner from '../components/v2/CtaBanner.astro';
import { withBase } from '../lib/url';
import { site } from '../config/site';

const stats = [
  { value: '10+', label: 'yıl saha tecrübesi' },
  { value: '2–4 ay', label: 'ortalama süreç' },
  { value: '3 kuşak', label: 'aile kapsamı' },
  { value: 'Euro', label: 'bazlı kira geliri' },
];

const values = [
  {
    icon: 'check',
    title: 'Şişirilmiş Fiyata Hayır',
    text: 'Sadece vize limitini doldurmak için pahalıya satılan mülklere karşı, gerçek piyasa değeriyle yatırım yaptırırız.',
  },
  {
    icon: 'pin',
    title: 'Doğru Lokasyon',
    text: 'Atina’dan Nafplio’ya; kira sürekliliği, likidite ve yaşam kalitesi yüksek bölgelere yönlendiririz.',
  },
  {
    icon: 'shield',
    title: 'Dürüst Ekspertiz',
    text: 'Bir mülkün gerçek fırsat mı yoksa balon mu olduğunu, 10 yıllık saha tecrübemizle ayırt ederiz.',
  },
  {
    icon: 'calendar',
    title: 'Uçtan Uca Takip',
    text: 'Vekaletten tapuya, parmak izinden 5 yıllık yenilemeye kadar tüm süreci sizin adınıza yönetiriz.',
  },
];
---
<V2Layout
  title="Hakkımızda"
  description="Sirtakinvest, Yunanistan Golden Visa sürecinde 10 yılı aşkın saha tecrübesiyle doğru mülk, doğru fiyat ve doğru hukuki yapı kurar."
>
  <!-- HERO -->
  <section class="v2-section about-hero">
    <div class="v2-container about-grid">
      <div class="about-text">
        <span class="badge mono">HAKKIMIZDA</span>
        <h1 class="heading-lg about-title">Avrupa'da misafir değil, ev sahibi olun.</h1>
        <p class="about-lead body text-smoke">
          {site.name}, Yunanistan Golden Visa sürecinde {site.experienceYears} yılı aşkın saha
          tecrübesiyle yanınızda. Bizim için oturum izni, kârlı bir gayrimenkul yatırımının yanındaki
          en güzel “hediyedir”; asıl olan sermayenizi doğru mülke bağlamaktır.
        </p>
        <div class="about-actions">
          <ArrowPill href={withBase('/toplanti-planla')} label="Tanışalım" />
          <a class="ghost-btn" href={withBase('/projeler')}>Projeleri gör <Icon name="arrow-right" size={15} /></a>
        </div>
      </div>
      <div class="about-media">
        <V2Placeholder label="Atina" ember />
      </div>
    </div>
  </section>

  <!-- İSTATİSTİK -->
  <section class="v2-section section-top">
    <div class="v2-container">
      <div class="stats">
        {
          stats.map((s, i) => (
            <div class="stat reveal" style={`--d:${i * 70}ms`}>
              <span class="stat-v heading-sm">{s.value}</span>
              <span class="stat-l caption text-smoke">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HİKAYE -->
  <section class="v2-section">
    <div class="v2-container">
      <div class="story">
        <h2 class="heading story-title">Neden {site.name}?</h2>
        <div class="prose story-prose">
          <p>
            Yunanistan, kriz günlerini çoktan geride bıraktı; bugün Avrupa'nın en diri yatırım
            merkezlerinden biri. Ancak bir yatırımcı olarak asıl mesele sadece oturum izni almak değil,
            paranızın karşılığını gerçekten almaktır. Doğru bir stratejiyle yapılan yatırım, size sadece
            bir “kart” kazandırmaz; yarın satmak istediğinizde yerel halkın bile talip olacağı, gerçek
            değeri olan bir mülk kazandırır.
          </p>
          <p>
            Golden Visa'yı tek bir kişinin aldığı oturum kartı olarak değil, eşinizi, çocuklarınızı,
            anne-babanızı ve eşinizin anne-babasını kapsayan bir <strong>aile koruma kalkanı</strong>
            olarak görüyoruz. Her ailenin yapısı farklıdır; bu yüzden yatırımı, olası boşanma, miras veya
            aileye yeni katılacak bireyler gibi senaryoları da düşünerek baştan doğru kurgularız.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- DEĞERLER -->
  <section class="v2-section">
    <div class="v2-container">
      <div class="vsec-head">
        <span class="badge mono">ÇALIŞMA İLKEMİZ</span>
        <h2 class="heading vsec-title">Yatırımınızı korumaya odaklanırız.</h2>
      </div>
      <div class="values-grid">
        {
          values.map((v, i) => (
            <div class="value-card v2-card reveal" style={`--d:${i * 70}ms`}>
              <span class="value-icon"><Icon name={v.icon} size={22} /></span>
              <h3 class="value-h subheading">{v.title}</h3>
              <p class="caption text-smoke">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section">
    <div class="v2-container">
      <CtaBanner />
    </div>
  </section>
</V2Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .about-title {
    margin-top: 16px;
    max-width: 16ch;
  }
  .about-lead {
    margin-top: 20px;
    max-width: 56ch;
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }
  .about-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--mist);
  }

  .section-top {
    padding-top: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--mist);
    border: 1px solid var(--mist);
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .stat {
    background: var(--bone);
    padding: 28px 24px;
    display: grid;
    gap: 6px;
  }
  .stat-v {
    color: var(--ink);
  }
  .stat-l {
    text-transform: lowercase;
  }

  .story {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .story-title {
    max-width: 14ch;
  }
  .story-prose {
    margin: 0;
  }

  .vsec-head {
    margin-bottom: 40px;
  }
  .vsec-title {
    margin-top: 16px;
    max-width: 24ch;
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .value-card {
    padding: var(--s-32);
  }
  .value-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: var(--bone);
    background: var(--ink);
    margin-bottom: 20px;
  }
  .value-h {
    color: var(--ink);
    margin-bottom: 10px;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-media {
      order: -1;
      aspect-ratio: 16 / 9;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .story {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
