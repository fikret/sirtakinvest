---
// Marka temalı yer tutucu görsel (dış dosya yok, tamamen CSS/SVG).
// Gerçek görsel geldiğinde bu bileşeni <img>/<Image> ile değiştirebilirsiniz.
interface Props {
  label?: string;
  tag?: string;
  ratio?: string; // örn "16/10", "4/3", "1/1"
  variant?: 'navy' | 'deep' | 'gold' | 'auto';
  subtle?: boolean; // yalnızca dokulu arka plan (metin gösterilmez)
  class?: string;
}
const { label = '', tag, ratio, variant = 'auto', subtle = false, class: className = '' } = Astro.props;

const palettes = ['navy', 'deep', 'gold'] as const;
let v: string = variant;
if (variant === 'auto') {
  let h = 0;
  for (const ch of label) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  v = palettes[h % palettes.length];
}
const style = ratio ? `aspect-ratio:${ratio}` : undefined;
---
<div class={`ph ph-${v} ${className}`} style={style} aria-hidden="true">
  <svg class="ph-key" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
    <path d="M3 21V3h18v18H8V9h7v6" />
  </svg>
  <svg class="ph-key ph-key-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
    <path d="M3 21V3h18v18H8V9h7v6" />
  </svg>
  {
    !subtle && (
      <div class="ph-inner">
        <span class="ph-mark">SIRTAKINVEST</span>
        {label && <span class="ph-label">{label}</span>}
        {tag && <span class="ph-tag">{tag}</span>}
      </div>
    )
  }
</div>

<style>
  .ph {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--gold-400);
    isolation: isolate;
  }
  .ph-navy {
    background:
      radial-gradient(120% 120% at 80% 0%, rgba(29, 90, 134, 0.55), transparent 60%),
      linear-gradient(155deg, var(--navy-700), var(--navy-900));
  }
  .ph-deep {
    background:
      radial-gradient(120% 120% at 15% 100%, rgba(200, 162, 75, 0.28), transparent 55%),
      linear-gradient(150deg, var(--navy-800), #071a2c);
  }
  .ph-gold {
    background:
      radial-gradient(120% 120% at 85% 15%, rgba(217, 189, 120, 0.45), transparent 55%),
      linear-gradient(150deg, var(--navy-800), var(--navy-700));
  }
  .ph-key {
    position: absolute;
    width: 58%;
    height: auto;
    right: -10%;
    bottom: -14%;
    opacity: 0.14;
    z-index: -1;
  }
  .ph-key-2 {
    right: auto;
    bottom: auto;
    left: -12%;
    top: -16%;
    width: 38%;
    opacity: 0.08;
    transform: rotate(180deg);
  }
  .ph-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1.4rem;
  }
  .ph-mark {
    font-family: var(--font-body);
    font-size: 0.66rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(247, 243, 234, 0.62);
  }
  .ph-label {
    font-family: var(--font-display);
    font-weight: 540;
    font-size: clamp(1.25rem, 1rem + 1.4vw, 1.9rem);
    line-height: 1.12;
    color: var(--paper);
    max-width: 14ch;
    text-wrap: balance;
  }
  .ph-tag {
    margin-top: 0.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-400);
    padding: 0.3em 0.9em;
    border: 1px solid rgba(217, 189, 120, 0.4);
    border-radius: 999px;
  }
</style>
