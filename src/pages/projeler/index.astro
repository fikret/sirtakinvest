---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getProjects, projectHref } from '../../lib/content';

const projects = await getProjects();
---
<BaseLayout
  title="Projeler"
  description="Golden Visa'ya uygun, doğru fiyatlı yatırım projeleri: Atina, Glyfada, Nafplio, Selanik ve Pire."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Portföy</span>
      <h1>Projelerimiz</h1>
      <p class="lead">
        Şişirilmiş fiyatlardan uzak; gerçek piyasa değerinde, kiralanabilir ve gerektiğinde
        satılabilir Golden Visa yatırım fırsatları.
      </p>
      <p class="note">Aşağıdaki kayıtlar örnek (placeholder) projelerdir; gerçek görsel ve detaylar eklenecektir.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="project-grid">
        {
          projects.map((p, i) => (
            <ProjectCard
              href={projectHref(p.id)}
              title={p.data.title}
              projectCode={p.data.projectCode}
              location={p.data.location}
              priceFrom={p.data.priceFrom}
              status={p.data.status}
              summary={p.data.summary}
              label={p.data.placeholderLabel}
              style={`--d:${i * 70}ms`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <CTABanner
        title="Size Uygun Projeyi Birlikte Bulalım"
        text="Bütçenize, yaşam tarzınıza ve yatırım hedefinize en uygun mülkü doğru fiyatla seçmek için tanışalım."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) 1.5rem;
    background: linear-gradient(180deg, var(--paper-2), transparent);
  }
  .page-hero h1 {
    margin-top: 0.6rem;
  }
  .page-hero .lead {
    margin-top: 1rem;
    max-width: 60ch;
  }
  .note {
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  @media (max-width: 980px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
