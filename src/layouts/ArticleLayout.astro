---
import V2Layout from './V2Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/v2/Breadcrumbs.astro';
import V2Placeholder from '../components/v2/V2Placeholder.astro';
import QuestionCard from '../components/v2/QuestionCard.astro';
import CtaBanner from '../components/v2/CtaBanner.astro';
import { categories, site } from '../config/site';
import type { CategoryKey } from '../config/site';
import { withBase } from '../lib/url';
import { categoryHref } from '../lib/content';

interface RelatedItem {
  href: string;
  cardTitle: string;
  spot: string;
  category: CategoryKey;
}
interface Props {
  title: string;
  spot: string;
  category: CategoryKey;
  label?: string;
  heroTag?: string;
  related?: RelatedItem[];
}
const { title, spot, category, label, heroTag, related = [] } = Astro.props;
const cat = categories[category];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: spot,
  inLanguage: 'tr',
  articleSection: cat.label,
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
};
---
<V2Layout title={title} description={spot} type="article">
  <article>
    <header class="v2-section article-hero">
      <div class="v2-container">
        <Breadcrumbs
          items={[
            { label: 'Ana Sayfa', href: withBase('/') },
            { label: 'Blog', href: withBase('/blog') },
            { label: cat.label, href: categoryHref(category) },
          ]}
        />
        <div class="ah-grid">
          <div class="ah-text">
            <span class="badge mono">{heroTag ?? cat.short}</span>
            <h1 class="heading ah-title">{title}</h1>
            <p class="ah-lead body text-smoke">{spot}</p>
          </div>
          <div class="ah-media">
            <V2Placeholder label={label ?? cat.short} ember />
          </div>
        </div>
      </div>
    </header>

    <div class="v2-container article-body">
      <div class="prose">
        <slot />
      </div>

      <aside class="article-back">
        <a class="ghost-btn" href={withBase('/blog')}>
          <Icon name="arrow-left" size={16} />
          Tüm Sorular
        </a>
        <a class="ghost-btn" href={categoryHref(category)}>
          {cat.label}
          <Icon name="arrow-right" size={16} />
        </a>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="v2-section">
          <div class="v2-container">
            <h2 class="heading-sm related-title">İlgili Sorular</h2>
            <div class="related-grid">
              {related.map((r, i) => (
                <QuestionCard
                  href={r.href}
                  num={String(i + 1).padStart(2, '0')}
                  question={r.cardTitle}
                  spot={r.spot}
                  index={i}
                />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <div class="v2-container article-cta">
      <CtaBanner />
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />
  </article>
</V2Layout>

<style>
  .article-hero {
    border-bottom: 1px solid var(--mist);
  }
  .ah-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: 28px;
  }
  .ah-title {
    margin-top: 16px;
    text-wrap: balance;
  }
  .ah-lead {
    margin-top: 16px;
    max-width: 52ch;
  }
  .ah-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--mist);
  }

  .article-body {
    padding-block: clamp(40px, 5vw, 72px);
  }
  .prose {
    margin-inline: auto;
  }
  .article-back {
    max-width: 68ch;
    margin: 48px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--mist);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .related-title {
    margin-bottom: 28px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .article-cta {
    padding-bottom: var(--section-gap);
  }

  @media (max-width: 900px) {
    .ah-grid {
      grid-template-columns: 1fr;
    }
    .ah-media {
      order: -1;
      aspect-ratio: 16 / 9;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
