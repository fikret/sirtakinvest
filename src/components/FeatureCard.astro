---
import Icon from './Icon.astro';
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  variant?: 'cta' | 'category';
  label?: string;
  class?: string;
  style?: string;
}
const { href, title, subtitle, variant = 'category', label, class: className = '', style } = Astro.props;
---
<a class={`card feature-card feature-${variant} reveal ${className}`} href={href} style={style}>
  {
    variant === 'category' && (
      <div class="fc-bg">
        <PlaceholderImage label={label ?? title} variant="auto" subtle />
      </div>
    )
  }
  <div class="fc-content">
    {variant === 'cta' && <span class="fc-eyebrow"><Icon name="calendar" size={16} />Ücretsiz</span>}
    <h3 class="fc-title">{title}</h3>
    {subtitle && <p class="fc-sub">{subtitle}</p>}
    <span class="fc-action">
      {variant === 'cta' ? 'Randevu Al' : 'Keşfet'}
      <Icon name="arrow-up-right" size={18} />
    </span>
  </div>
</a>

<style>
  .feature-card {
    position: relative;
    min-height: 220px;
    justify-content: flex-end;
    padding: 1.6rem;
    overflow: hidden;
  }

  /* CTA — navy gradient */
  .feature-cta {
    background:
      radial-gradient(120% 120% at 85% 10%, rgba(29, 90, 134, 0.6), transparent 60%),
      linear-gradient(155deg, var(--navy-700), var(--navy-900));
    color: var(--paper);
    border-color: transparent;
  }
  .feature-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(80% 60% at 50% 120%, rgba(200, 162, 75, 0.28), transparent 70%);
    pointer-events: none;
  }
  .fc-eyebrow {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin-bottom: 0.7rem;
  }

  /* Category — placeholder image background */
  .fc-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .fc-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 34, 56, 0.05) 30%, rgba(10, 34, 56, 0.72));
  }
  .feature-category .fc-content {
    color: var(--paper);
  }

  .fc-content {
    position: relative;
    z-index: 1;
  }
  .fc-title {
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.9rem);
    line-height: 1.1;
    color: inherit;
    text-wrap: balance;
  }
  .feature-cta .fc-title {
    color: var(--paper);
  }
  .fc-sub {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(247, 243, 234, 0.85);
    max-width: 32ch;
  }
  .fc-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.1rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--gold-400);
  }
  .fc-action :global(svg) {
    transition: transform 0.3s var(--ease);
  }
  .feature-card:hover .fc-action :global(svg) {
    transform: translate(3px, -3px);
  }
</style>
