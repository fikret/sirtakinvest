---
// Altın renkli, ortasında Yunan meander (anahtar) motifi olan ince ayraç.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class={`meander ${className}`} role="presentation">
  <span class="meander-rule"></span>
  <svg class="meander-key" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
    <path d="M3 21V3h18v18H8V9h7v6" />
  </svg>
  <span class="meander-rule"></span>
</div>

<style>
  .meander {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--gold-500);
    width: min(360px, 70%);
    margin-inline: auto;
  }
  .meander-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-500));
  }
  .meander-rule:last-child {
    background: linear-gradient(90deg, var(--gold-500), transparent);
  }
  .meander-key {
    width: 22px;
    height: 22px;
    flex: none;
  }
</style>
