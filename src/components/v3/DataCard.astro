---
/** Financial data card mockup — Column'un birincil illüstrasyon aracı (foto yerine). */
interface Props {
  flag?: string;
  label: string;
  value: string;
  sub?: string;
  status?: string;
  float?: boolean;
  class?: string;
}
const { flag, label, value, sub, status, float = false, class: className = '' } = Astro.props;
---
<div class={`dcard v3-card ${float ? 'float' : ''} ${className}`}>
  <div class="dcard-head">
    <span class="dcard-acct">
      {flag && <span class="dcard-flag" aria-hidden="true">{flag}</span>}
      {label}
    </span>
    {status && <span class="dcard-status mono">{status}</span>}
  </div>
  <hr class="hairline" />
  <div class="dcard-value">{value}</div>
  {sub && <div class="dcard-sub mono">{sub}</div>}
  <slot />
</div>

<style>
  .dcard {
    padding: var(--s-24);
    display: grid;
    gap: var(--s-12);
  }
  .dcard-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .dcard-acct {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--ink);
  }
  .dcard-flag {
    font-size: 1rem;
    line-height: 1;
  }
  .dcard-status {
    font-size: 0.625rem;
    color: var(--slate);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dcard-value {
    font-weight: 300;
    font-size: 1.75rem; /* 28px */
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.1;
  }
  .dcard-sub {
    font-size: 0.625rem; /* 10px */
    color: var(--slate);
  }
  .hairline {
    margin-block: 2px;
  }
</style>
