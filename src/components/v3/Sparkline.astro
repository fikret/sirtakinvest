---
interface Props {
  points: number[];
  color?: string;
  w?: number;
  h?: number;
  fill?: boolean;
  class?: string;
}
const { points, color = '#ffffff', w = 220, h = 56, fill = true, class: className = '' } = Astro.props;
const min = Math.min(...points);
const max = Math.max(...points);
const span = max - min || 1;
const step = points.length > 1 ? w / (points.length - 1) : w;
const pad = 5;
const coords = points.map((p, i) => {
  const x = i * step;
  const y = pad + (1 - (p - min) / span) * (h - pad * 2);
  return [Math.round(x * 10) / 10, Math.round(y * 10) / 10];
});
const line = coords.map((c, i) => `${i === 0 ? 'M' : 'L'}${c[0]} ${c[1]}`).join(' ');
const area = `${line} L${w} ${h} L0 ${h} Z`;
---
<svg class={className} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" width="100%" aria-hidden="true">
  {fill && <path d={area} fill={color} opacity="0.14" />}
  <path d={line} fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx={coords[coords.length - 1][0]} cy={coords[coords.length - 1][1]} r="3" fill={color} />
</svg>
